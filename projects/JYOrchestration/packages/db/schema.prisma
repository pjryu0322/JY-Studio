generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 프로젝트 멤버 역할 구분
enum ProjectMemberRole {
  /// 소유자
  OWNER
  /// 편집자(생성/수정/실행)
  EDITOR
  /// 검토
  REVIEWER
  /// 조회 전용
  VIEWER
}

/// 프로젝트 멤버 유형
enum ProjectMemberType {
  /// 사람 사용자
  HUMAN
  /// AI 멤버
  AI
}

/// AI(또는 멤버) 액션 유형
enum AiMemberActionType {
  /// 코드/변경 리뷰 요청
  REVIEW_REQUEST
  /// Task 초안 생성 요청
  TASK_DRAFT_REQUEST
  /// QA 점검 요청
  QA_CHECK_REQUEST
  /// 요약 요청
  SUMMARY_REQUEST
}

/// AI 멤버 액션 진행 상태
enum AiMemberActionStatus {
  /// 요청됨
  REQUESTED
  /// 진행 중
  IN_PROGRESS
  /// 완료
  DONE
  /// 실패
  FAILED
  /// 취소
  CANCELED
}

/// 실행 모드(스텁·수동·OpenAI·내부 에이전트)
enum AiMemberActionExecutionMode {
  /// 즉시 더미/수동 완료용
  STUB
  /// 내부 워커/운영자 처리
  MANUAL_AGENT
  /// OpenAI 등 외부 LLM 연동(향후)
  OPENAI
  /// 내부 에이전트 실행
  INTERNAL_AGENT
}

/// AI 멤버 액션 사람 검토 상태
enum AiMemberActionReviewStatus {
  /// 검토 대기(결과는 제안 단계)
  PENDING_REVIEW
  /// 승인됨(적용은 별도)
  APPROVED
  /// 반려됨
  REJECTED
  /// 수정/재실행 요청
  NEEDS_REVISION
}

/// AI 승인 결과 시스템 반영 상태
enum AiMemberActionApplyStatus {
  /// 미적용
  NOT_APPLIED
  /// 반영 완료
  APPLIED
  /// 반영 실패
  APPLY_FAILED
}

/// AI 액션 검토 결정(이력 로그)
enum AiMemberActionReviewDecision {
  APPROVE
  REJECT
  REQUEST_REVISION
}

/// 프로젝트별 AI 액션 승인 정책(사람 검토 생략 vs 필수)
enum ProjectAiActionApprovalMode {
  /// 정책에 따라 완료 시 자동 승인 처리(적용은 applyMode 별도)
  AUTO_APPROVE
  /// 사람 검토 후 승인
  MANUAL_REVIEW
}

/// 프로젝트별 AI 승인 결과 시스템 반영 정책
enum ProjectAiActionApplyMode {
  /// 승인 후 자동 반영(ingest)
  AUTO_APPLY
  /// 사용자가 적용 버튼으로 반영
  MANUAL_APPLY
}

model User {
  /// 사용자 ID
  id           String   @id @default(cuid())
  /// 이메일
  email        String   @unique
  /// 비밀번호 해시
  passwordHash String
  /// 사용자 이름
  name         String
  /// 전역 권한
  globalRole   String   @default("USER")
  /// 생성일시
  createdAt    DateTime @default(now())
  /// 수정일시
  updatedAt    DateTime @updatedAt

  /// 소유한 프로젝트 목록
  ownedProjects Project[]
  /// 프로젝트 멤버십 목록
  memberships   ProjectMember[]
  /// 초대한 프로젝트 멤버 목록
  invitedProjectMembers ProjectMember[] @relation("ProjectMemberInvitedBy")
  /// 요청한 AI 멤버 액션 목록
  requestedMemberActions ProjectMemberAction[] @relation("ProjectMemberActionRequestedBy")
  /// 검토 완료로 표시한 AI 멤버 액션
  reviewedAiMemberActions ProjectMemberAction[] @relation("ProjectMemberActionReviewedBy")
  /// 승인 결과를 적용한 AI 멤버 액션
  appliedAiMemberActions ProjectMemberAction[] @relation("ProjectMemberActionAppliedBy")
  /// AI 멤버 액션 검토 로그
  aiMemberActionReviewLogs AiMemberActionReviewLog[]
  /// 소유 Task (프로젝트 소유자와 동일한 ownerUserId)
  ownedTasks      Task[]         @relation("TaskOwner")
  /// 소프트 삭제를 수행한 프로젝트(감사)
  softDeletedProjects Project[] @relation("ProjectSoftDeletedBy")

  @@map("users")
}

model Project {
  /// 프로젝트 ID
  id            String   @id @default(cuid())
  /// 프로젝트명
  name          String
  /// 프로젝트 설명
  description   String?
  /// 소유자 사용자 ID
  ownerUserId   String
  /// 소유자 사용자
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// 프로젝트 유형
  projectType   String
  /// 저장소 URL
  repoUrl       String?
  /// 기본 브랜치
  defaultBranch String?
  /// 프로젝트 생명주기: ACTIVE | DELETED (소프트 삭제)
  status        String
  /// 워크플로 단계: null=기존·제한 없음, REQUIREMENTS_PENDING=신규 생성 후 요구사항 단계 필수(실행 계획 진입 전)
  workflowStatus String?
  /// 소프트 삭제 시각
  deletedAt     DateTime?
  /// 소프트 삭제 수행 사용자
  deletedByUserId String?
  deletedBy     User?              @relation("ProjectSoftDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  /// Git 승인 게이트 모드(NO_APPROVAL·MANUAL_APPROVAL 등)
  gitApprovalMode String           @default("NO_APPROVAL")
  /// Git push 정책(AUTO_PUSH·MANUAL_PUSH)
  gitPushMode     String           @default("AUTO_PUSH")
  /// Task 실행 완료 시 Git 변경 요청 자동 생성 여부
  autoCreateGitRequest Boolean     @default(true)
  /// 생성일시
  createdAt     DateTime           @default(now())
  /// 수정일시
  updatedAt     DateTime           @updatedAt

  /// Project Spec 정의 워크스페이스: 핵심 목표(문단)
  specCoreGoals       String? @db.Text
  /// In scope (불릿/텍스트)
  specScopeIn         String? @db.Text
  /// Out of scope (불릿/텍스트)
  specScopeOut        String? @db.Text
  /// 대상 사용자 (불릿/텍스트)
  specTargetUsers     String? @db.Text
  /// 성공 기준 (불릿/텍스트)
  specSuccessCriteria String? @db.Text
  /// F-1-3-1c 저장된 실행 계획 전체(마크다운). Project Spec 생성의 유일한 본문 입력
  executionPlanMarkdown   String? @db.Text
  /// 멀티 모델 플랜 후보 중 사용자가 선택한 항목 ID(클라이언트 생성)
  selectedPlanCandidateId String?
  /// 사용자가 확정한 공식 Project Spec (마크다운)
  confirmedSpecMarkdown   String? @db.Text
  confirmedSpecResponseId String?
  confirmedSpecAt         DateTime?
  /// 확정 출처 타입(RESPONSE 또는 MERGED_SECTIONS 등)
  confirmedSpecSourceType String?
  /// 확정 출처 상세(응답 ID, 섹션 선택 매핑 등)
  confirmedSpecSourceData Json?

  /// 업로드된 스펙 파일
  uploads       ProjectSpecUpload[]
  /// 태스크
  tasks         Task[]
  /// 태스크 프롬프트
  taskPrompts   TaskPrompt[]
  /// Git 변경 요청
  gitRequests   GitChangeRequest[]
  /// 프로젝트 멤버
  members       ProjectMember[]
  /// 태스크 이력
  taskHistories TaskHistory[]
  /// 실행 작업
  executionJobs ExecutionJob[]
  /// 실행 이벤트 로그
  executionEventLogs ExecutionEventLog[]
  /// 멤버(주로 AI) 대상 액션 요청
  memberActions ProjectMemberAction[]
  /// AI 멤버 액션 승인·적용 정책(액션 유형별)
  aiActionPolicies ProjectAiActionPolicy[]
  /// Spec 정의 워크스페이스: 생성된 프롬프트 버전
  specWorkspacePrompts ProjectSpecWorkspacePrompt[]
  /// Spec 정의 워크스페이스: AI 응답
  specWorkspaceResponses ProjectSpecWorkspaceResponse[]
  /// 확정 Project Spec 버전 이력(append-only)
  specVersions ProjectSpecVersion[] @relation("ProjectSpecVersions")
  /// 현재 활성 확정 Spec이 가리키는 버전 행
  currentSpecVersionId String? @unique
  currentSpecVersion   ProjectSpecVersion? @relation("ProjectCurrentSpecVersion", fields: [currentSpecVersionId], references: [id], onDelete: SetNull)
  /// Spec 기반 Task 초안(AI 생성·검토 후 Task 확정)
  taskDrafts TaskDraft[]
  /// 실행 환경 연결(프로젝트별)
  executionSetup ExecutionSetup?
  /// F-1-3-3 Spec AI 생성용 사용자 편집 프롬프트 템플릿
  specPromptConfig SpecPromptConfig?
  /// Task 생성(요구사항 추출)용 사용자 프롬프트 템플릿 (editable, null이면 기본값 사용)
  taskPrompt       String?           @db.Text
  /// F-1-3-5 단일 호출 Task 생성용 사용자 프롬프트 템플릿 (null이면 기본값)
  taskGenerationPrompt String?       @db.Text
  /// 오케스트레이션 실행 루프 시도 기록
  taskExecutionRuns TaskExecutionRun[]
  /// 요구사항 협의실: 채팅·회의록 등(JSON, 클라이언트 스키마 v1)
  requirementsRoomState Json?

  @@index([ownerUserId])
  @@map("projects")
}

/// Project Spec AI 생성 — 사용자에게 노출되는 템플릿 레이어 + 프리셋
model SpecPromptConfig {
  id             String   @id @default(cuid())
  projectId      String   @unique
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templatePrompt String   @db.Text
  /// default | public-si | startup-mvp | ai-product
  preset         String   @default("default")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("spec_prompt_configs")
}

/// 프로젝트별 실행 환경 연결(Repo/Executor/Policy)
model ExecutionSetup {
  id        String   @id @default(cuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Git
  gitRepoUrl      String
  /// github | other (URL이 진실, UI/정책 힌트용)
  gitRepoProvider String   @default("github")
  gitRepoName     String?
  baseBranch      String
  /// feature-per-workflow | feature-per-task | manual
  branchStrategy  String
  branchPrefix    String?

  /// GitHub auth (platform-managed)
  /// 평문 DB 저장(백업·접근 통제). 일반 GET/PATCH 응답에는 미포함·마스킹만. 소유자 일시 확인은 전용 reveal 엔드포인트로만.
  githubAccessToken String? @db.Text
  githubAccessTokenMasked String?
  /// GitHub 토큰으로 API 접근이 가능한지 — null이면 아직 검증 안 함
  githubAuthConnectionOk Boolean?
  githubAuthValidatedAt DateTime?
  githubAuthValidationError String? @db.Text
  /// GitHub PAT 단계별 권한 프로브 결과(JSON): repo/prRead/prCreate/prMerge/operable, HTTP, X-Accepted-GitHub-Permissions
  githubCapabilityValidation Json?

  /// Cursor executor
  cursorApiUrl    String
  /// 평문 DB 저장(백업·접근 통제). 일반 GET/PATCH 응답에는 미포함·마스킹만. 소유자 일시 확인은 전용 reveal API만.
  cursorApiToken  String?  @db.Text
  cursorApiTokenMasked String?
  workspacePath   String
  projectRootPath String

  /// Execution policy
  autoCommit  Boolean @default(true)
  autoPush    Boolean @default(false)
  autoPr      Boolean @default(false)
  requireApprovalBeforeApply Boolean @default(true)
  requireTestsBeforePush     Boolean @default(true)
  dryRunAllowed Boolean @default(true)
  /// DAG 실행 루프: Task 완료 시 다음 ready Task 자동 실행
  autoAdvanceToNextTask   Boolean @default(true)
  /// Cursor/OpenAI 루프에서 Task당 최대 자동 재시도(초과 시 failed)
  maxAutoRetriesPerTask   Int     @default(2)
  /// 평가 시 테스트/빌드 실패면 즉시 failed 처리
  stopOnTestFailure       Boolean @default(true)
  /// 동일 Cursor/평가 오류가 연속이면 즉시 failed (재시도 낭비 방지)
  stopOnRepeatedFailure   Boolean @default(true)
  /// 허용 glob 밖 변경이면 즉시 failed
  stopOnOutOfScopeChange  Boolean @default(true)
  /// 민감 키워드 Task는 OpenAI done 이어도 사람 승인 전까지 DAG 진행 안 함
  requireApprovalForSensitiveTasks Boolean @default(false)
  /// 대상 저장소에서 실행할 검증 커맨드 문자열 배열(JSON), 예: ["npm test","npm run build"]
  repoValidationCommands Json?
  /// Cursor/실행 프롬프트에 주입할 허용 경로 글로브(JSON 문자열 배열)
  allowedPathGlobs        Json?

  /// draft | validated | invalid
  status          String   @default("draft")
  lastValidatedAt DateTime?
  /// 연결 검증 이후 git/repo/cursor/경로 등이 바뀌면 true (재검증 필요)
  needsRevalidation Boolean @default(false)
  /// 마지막 연결/검증 실패 메시지(요약)
  lastValidationError String? @db.Text

  /// 저장소( Git URL·브랜치 ) 연결 검증 성공 여부 — null 이면 아직 검증 안 함
  repoConnectionOk     Boolean?
  repoValidatedAt      DateTime?
  repoValidationError  String?  @db.Text
  /// Cursor API URL·키·연결·인증·저장소 형식( readiness )까지 — 실행(Agent) 검증과 별도
  cursorApiConnectionOk   Boolean?
  cursorApiValidatedAt    DateTime?
  cursorApiValidationError String? @db.Text
  /// Cursor가 저장소에서 Agent 실행을 받아들이는지( Cloud Agent 검증 )
  executorConnectionOk     Boolean?
  executorValidatedAt      DateTime?
  executorValidationError    String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("execution_setups")
}

/// Task 단위 실제 실행(Cursor/Git/평가) 시도 기록
model TaskExecutionRun {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 확정 Spec 버전 등 워크플로 계보(없으면 null)
  workflowId String?
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// cursor (향후 github 확인 워커 등 확장)
  provider  String   @default("cursor")
  /// 실행 시점 저장소 URL 스냅샷(교차 저장소 감사)
  repoUrlSnapshot String?
  /// running | reviewing | done | retry_needed | failed | paused
  status    String
  branchName       String?
  cursorRunId      String?
  promptSnapshot   String?  @db.Text
  cursorSummary    String?  @db.Text
  changedFiles     Json?
  gitSummary       String?  @db.Text
  evaluationReason String?  @db.Text
  /// done | retry | failed (OpenAI 평가 결과)
  evaluationDecision String?
  /// AI 멤버(실행 후 검토) 단계별 결과 JSON 배열
  evaluationReviewerSteps Json?
  validationOutput String?  @db.Text
  /// Cursor HTTP/실패 메시지
  runError         String?  @db.Text
  commitStatus     String?
  pushStatus       String?
  commitSha        String?
  /// autoPr 미구현 시 pending_capability 등
  prStatus         String?
  retryCount       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  /// 터미널 성공/실패 등 확정 시각(ENV_TEST PR_OPENED 등)
  completedAt      DateTime?
  /// ENV_TEST 스모크: GitHub PR squash 머지 후 merge commit SHA
  mergeCommitSha   String?
  /// ENV_TEST 스모크: 머지 확정 시각
  mergedAt         DateTime?
  /// ENV_TEST 스모크: 원격 테스트 브랜치 삭제 완료 시각(옵션)
  envTestRemoteBranchDeletedAt DateTime?
  /// ENV_TEST 머지 스모크: 머지 차단(가드 실패 등) 사유
  envTestMergeBlockedReason String?
  /// ENV_TEST 머지 스모크: 머지 안전 가드 시작 시각(머지 진행 중 UI 표시에 사용)
  envTestMergeStartedAt DateTime?
  /// 스펙 전환 등으로 소속 Task가 보관되면 함께 보관(현재 스펙 실행·관측 분리)
  archivedAt       DateTime?

  @@index([projectId, taskId, createdAt])
  @@index([projectId, archivedAt])
  @@map("task_execution_runs")
}

/// 확정 Project Spec의 버전(덮어쓰기 없음, 항상 append)
model ProjectSpecVersion {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation("ProjectSpecVersions", fields: [projectId], references: [id], onDelete: Cascade)
  /// 프로젝트별 1부터 증가
  version   Int
  markdown  String   @db.Text
  /// RESPONSE | MERGED_SECTIONS | MANUAL_EDIT | AI_REFINE | LEGACY_IMPORT 등
  sourceType String
  sourceData Json?
  createdAt DateTime @default(now())
  createdByUserId String?

  currentForProject Project? @relation("ProjectCurrentSpecVersion")
  /// 이 Spec 버전에서 생성된 Task 초안
  taskDrafts TaskDraft[]
  /// 이 Spec 버전에서 확정된 Task(업로드 없이 생성된 경우)
  sourcedTasks Task[] @relation("TaskSourceSpecVersion")

  @@unique([projectId, version])
  @@index([projectId])
  @@map("project_spec_versions")
}

/// AI가 Project Spec을 바탕으로 생성한 Task 초안(확정 전 검토용)
model TaskDraft {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 생성 기준이 된 Project Spec 버전
  specVersionId String
  specVersion   ProjectSpecVersion @relation(fields: [specVersionId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  priority    String   @default("MEDIUM")
  /// 선행 Task 제목 문자열 배열(JSON)
  dependsOn           Json?
  /// 선행 TaskDraft id 배열(JSON) — Workflow 캔버스 연결용
  dependsOnIds        Json?
  /// 수용 기준 문자열 배열(JSON)
  acceptanceCriteria  Json?
  /// 실행 Task 입력(무엇을 받는지)
  taskInput           String?  @db.Text
  /// 실행 Task 출력(무엇을 내는지)
  taskOutput          String?  @db.Text
  /// S | M | L
  estimatedSize       String?
  /// api | logic | ui | infra | test
  executionKind       String?
  /// Workflow 캔버스 노드 X 좌표(px)
  positionX          Float @default(0)
  /// Workflow 캔버스 노드 Y 좌표(px)
  positionY          Float @default(0)
  /// Workflow 단계(스윔레인)
  stage              String @default("Build")
  /// 생성 주체: AI | USER
  createdByType      String @default("AI")
  /// DRAFT | CONFIRMED | SUPERSEDED
  status      String   @default("DRAFT")
  sourceModel String?
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  createdByUserId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, status])
  @@index([projectId, specVersionId])
  @@map("task_drafts")
}

/// Project Spec 정의 워크스페이스 — 생성·저장된 프롬프트(버전별)
model ProjectSpecWorkspacePrompt {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  promptText  String   @db.Text
  createdAt   DateTime @default(now())
  createdByUserId String?

  responses ProjectSpecWorkspaceResponse[]

  @@unique([projectId, version])
  @@index([projectId])
  @@map("project_spec_workspace_prompts")
}

/// Project Spec 정의 워크스페이스 — AI 응답(프롬프트별 다중)
model ProjectSpecWorkspaceResponse {
  id               String   @id @default(cuid())
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptId         String
  prompt           ProjectSpecWorkspacePrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)
  provider         String
  model            String
  responseMarkdown String   @db.Text
  /// OpenAI 사용량: 입력 토큰 수
  promptTokens Int?
  /// OpenAI 사용량: 출력 토큰 수
  completionTokens Int?
  /// OpenAI 사용량: 총 토큰 수
  totalTokens Int?
  status           String
  createdAt        DateTime @default(now())
  /// 후보 품질 점수 JSON: { completeness, structure, executionReadiness, total }
  specCandidateScore Json?
  /// 후보 메타 JSON: { sections, requirementCount, hasArchitecture }
  specCandidateMeta  Json?

  @@index([projectId])
  @@index([promptId])
  @@map("project_spec_workspace_responses")
}

/// 레거시: 앱은 더 이상 조회하지 않음(리뷰어 멤버 필드로 통합). 행은 보존될 수 있음.
model ProjectAiActionPolicy {
  /// 정책 행 ID
  id             String                    @id @default(uuid())
  /// 프로젝트 ID
  projectId      String
  /// 액션 유형
  actionType     AiMemberActionType
  /// 승인 모드(행 없음 = 기본 자동 승인과 동일)
  approvalMode   ProjectAiActionApprovalMode
  /// 적용 모드(행 없음 = 기본 수동 적용과 동일)
  applyMode      ProjectAiActionApplyMode   @default(MANUAL_APPLY)
  /// 생성일시
  createdAt      DateTime                   @default(now())
  /// 수정일시
  updatedAt      DateTime                   @updatedAt
  /// 소속 프로젝트
  project        Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, actionType])
  @@index([projectId])
  @@map("project_ai_action_policies")
}

model ExecutionJob {
  /// 실행 작업 ID
  id         String    @id @default(uuid())
  /// 프로젝트 ID
  projectId  String
  /// 작업 유형(git-apply·pipeline·cursor)
  type       String
  /// 상태(PENDING·RUNNING·DONE·FAILED)
  status     String    @default("PENDING")
  /// 누적 실패 횟수
  retryCount Int       @default(0)
  /// 최대 시도 횟수
  maxAttempts Int      @default(3)
  /// 실행 페이로드(JSON)
  payload    Json
  /// 실행 결과(JSON)
  result     Json?
  /// 최근 실패 원인
  lastError  String?
  /// 재시도 가능 시각
  availableAt DateTime?
  /// 워커 클레임 식별자
  claimedBy  String?
  /// 하트비트 시각
  heartbeatAt DateTime?
  /// 최종 오류 요약
  error      String?
  /// 시작 시각
  startedAt  DateTime?
  /// 종료 시각
  finishedAt DateTime?
  /// 생성일시
  createdAt  DateTime  @default(now())
  /// 소속 프로젝트
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 이벤트 로그
  eventLogs  ExecutionEventLog[]

  @@index([projectId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, availableAt, createdAt])
  @@map("execution_jobs")
}

model ExecutionEventLog {
  /// 이벤트 로그 ID
  id                 String   @id @default(uuid())
  /// 프로젝트 ID
  projectId          String
  /// 실행 작업 ID
  executionJobId     String
  /// 태스크 ID
  taskId             String?
  /// Git 변경 요청 ID
  gitChangeRequestId String?
  /// 단계(PRECHECK·EXECUTE·APPLY·PR·RETRY·COMPLETE)
  stage              String
  /// 상태(STARTED·SUCCESS·FAILED)
  status             String
  /// 메시지
  message            String?
  /// 실패 유형 분류
  failureType       String?
  /// 상세 JSON
  detailJson         Json?
  /// 소요 시간(ms)
  durationMs         Int?
  /// 생성일시
  createdAt          DateTime @default(now())
  /// 소속 프로젝트
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 실행 작업
  executionJob       ExecutionJob @relation(fields: [executionJobId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([executionJobId])
  @@index([stage])
  @@map("execution_event_logs")
}

model ProjectMember {
  /// 멤버 행 ID
  id        String            @id @default(uuid())
  /// 프로젝트 ID
  projectId String
  /// 사용자 ID(HUMAN일 때 사용)
  userId    String?
  /// 멤버 유형(HUMAN/AI)
  memberType ProjectMemberType @default(HUMAN)
  /// 표시 이름(특히 AI 멤버용)
  displayName String?
  /// AI 제공자(OPENAI/INTERNAL 등)
  aiProvider String?
  /// AI 에이전트 식별 키
  aiAgentKey String?
  /// 오케스트레이션 AI 역할(planner·reviewer·security-reviewer 등, 사람 RBAC role 과 별개)
  aiOrchestrationRole String?
  /// 오케스트레이션이 참여하는 스테이지(spec·task·execution-review)
  orchestrationStage String?
  /// 이 멤버 전용 LLM 모델(비우면 프로젝트/환경 기본)
  aiModelOverride String?
  /// 오케스트레이션 파이프라인에 포함 여부(AI 멤버)
  orchestrationEnabled Boolean @default(true)
  /// 실행 리뷰어 전용: 액션 승인 모드. null이면 시스템 기본(AUTO_APPROVE)
  aiActionApprovalModeOverride ProjectAiActionApprovalMode?
  /// 실행 리뷰어 전용: 액션 적용 모드. null이면 시스템 기본(MANUAL_APPLY)
  aiActionApplyModeOverride ProjectAiActionApplyMode?
  /// 초대한 사용자 ID
  invitedByUserId String?
  /// 프로젝트 내 역할
  role      ProjectMemberRole
  /// 생성일시
  createdAt DateTime          @default(now())
  /// 수정일시
  updatedAt DateTime          @updatedAt
  /// 소속 프로젝트
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 연결 사용자(HUMAN 멤버)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 초대한 사용자
  invitedBy User?             @relation("ProjectMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  /// 할당된 멤버 액션
  memberActions ProjectMemberAction[]

  @@unique([projectId, userId])
  @@index([projectId, memberType])
  @@index([projectId, role])
  @@map("project_members")
}

/// 프로젝트 멤버(주로 AI)에 대한 협업 액션 요청
model ProjectMemberAction {
  /// 액션 ID
  id           String                  @id @default(uuid())
  /// 프로젝트 ID
  projectId    String
  /// 연결 태스크 ID(선택)
  taskId       String?
  /// 연결 태스크 프롬프트 ID(선택)
  taskPromptId String?
  /// 연결 태스크 실행 ID(선택)
  taskRunId    String?
  /// 연결 Git 변경 요청 ID(선택)
  gitChangeRequestId String?
  /// 대상 프로젝트 멤버 ID(AI 권장, HUMAN 확장 가능)
  projectMemberId String
  /// 액션 유형
  actionType   AiMemberActionType
  /// 상태
  status       AiMemberActionStatus    @default(REQUESTED)
  /// 요청 본문(JSON)
  requestPayload Json?
  /// 결과 본문(JSON)
  resultPayload  Json?
  /// 요청한 사용자 ID(세션 주체)
  requestedByUserId String
  /// 요청 시각
  requestedAt  DateTime                @default(now())
  /// 시작 시각
  startedAt    DateTime?
  /// 종료 시각
  finishedAt   DateTime?
  /// 오류 메시지
  errorMessage String?
  /// 마지막 오류(재시도·디스패처용)
  lastError    String?
  /// 실행 모드
  executionMode AiMemberActionExecutionMode @default(STUB)
  /// 실행기/프로바이더 식별(OPENAI_REVIEWER 등)
  providerKey  String?
  /// 실제 수행한 실행기 이름
  assignedExecutor String?
  /// 재시도 횟수
  retryCount   Int                     @default(0)
  /// 처리 가능 시각(백오프·스케줄)
  availableAt  DateTime?
  /// 디스패처/워커 클레임 식별자
  consumedBy   String?
  /// 상관 키(추적·멱등)
  correlationKey String?
  /// 요청 시점에 확정한 승인 정책 스냅샷(null이면 완료 시 DB 정책 또는 기본값으로 해석)
  resolvedApprovalMode ProjectAiActionApprovalMode?
  /// 요청 시점에 확정한 적용 정책 스냅샷
  resolvedApplyMode    ProjectAiActionApplyMode?
  /// 사람 검토 상태(AI 결과 제안 vs 승인 후)
  reviewStatus      AiMemberActionReviewStatus?
  /// 검토(승인/반려) 수행 사용자
  reviewedByUserId  String?
  /// 검토 시각
  reviewedAt        DateTime?
  /// 검토 코멘트(반려 사유 등)
  reviewComment     String?
  /// 승인 시점 스냅샷(적용 시 사용)
  approvedPayload   Json?
  /// 승인 결과 적용 상태
  applyStatus       AiMemberActionApplyStatus @default(NOT_APPLIED)
  /// 적용 시각
  appliedAt         DateTime?
  /// 적용 수행 사용자
  appliedByUserId   String?
  /// 수정일시
  updatedAt    DateTime                @updatedAt
  /// 소속 프로젝트
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 대상 멤버
  projectMember ProjectMember  @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  /// 연결 태스크
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// 연결 프롬프트
  taskPrompt    TaskPrompt?    @relation(fields: [taskPromptId], references: [id], onDelete: SetNull)
  /// 연결 실행
  taskRun       TaskRun?       @relation(fields: [taskRunId], references: [id], onDelete: SetNull)
  /// 연결 Git 변경 요청
  gitChangeRequest GitChangeRequest? @relation(fields: [gitChangeRequestId], references: [id], onDelete: SetNull)
  /// 요청한 사용자
  requestedBy   User           @relation("ProjectMemberActionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Cascade)
  /// 검토(승인/반려)한 사용자
  reviewedBy    User?          @relation("ProjectMemberActionReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  /// 승인 결과를 적용한 사용자
  appliedBy     User?          @relation("ProjectMemberActionAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  /// 검토 결정 이력
  reviewLogs    AiMemberActionReviewLog[]

  @@index([projectId, requestedAt])
  @@index([taskId])
  @@index([projectMemberId])
  @@index([status, availableAt, requestedAt])
  @@index([projectId, reviewStatus])
  @@map("project_member_actions")
}

/// AI 멤버 액션 검토·승인/반려 결정 이력
model AiMemberActionReviewLog {
  /// 로그 ID
  id               String                       @id @default(uuid())
  /// 대상 액션 ID
  actionId         String
  /// 검토자 사용자 ID
  reviewerUserId   String
  /// 결정 유형
  decision         AiMemberActionReviewDecision
  /// 코멘트
  comment          String?
  /// 생성일시
  createdAt        DateTime                     @default(now())
  /// 대상 액션
  action           ProjectMemberAction          @relation(fields: [actionId], references: [id], onDelete: Cascade)
  /// 검토자
  reviewer         User                         @relation(fields: [reviewerUserId], references: [id], onDelete: Cascade)

  @@index([actionId, createdAt])
  @@map("ai_member_action_review_logs")
}

model ProjectSpecUpload {
  /// 업로드 ID
  id               String   @id @default(uuid())
  /// 프로젝트 ID
  projectId        String
  /// 소스 유형
  sourceType       String?
  /// 원본 파일명
  originalFileName String
  /// 파일 MIME/유형
  fileType         String
  /// 파일 크기(바이트)
  fileSize         Int
  /// 본문 텍스트(선택)
  contentText      String?
  /// 본문 저장 여부
  contentStored    Boolean  @default(false)
  /// 업로드 상태
  status           String   @default("REGISTERED")
  /// 파싱 결과 JSON
  parsedJson       Json?
  /// 파싱 상태
  parseStatus      String?  @default("PENDING")
  /// 파싱 완료 시각
  parsedAt         DateTime?
  /// 생성일시
  createdAt        DateTime @default(now())
  /// 수정일시
  updatedAt        DateTime @updatedAt
  /// 소속 프로젝트
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 파생 태스크
  tasks            Task[]

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}

model Task {
  /// 태스크 ID
  id                  String            @id @default(uuid())
  /// 프로젝트 ID
  projectId           String
  /// 태스크 소유 사용자 ID(프로젝트 소유자와 동일해야 함)
  ownerUserId         String
  /// 스펙 업로드 ID(레거시 업로드 파이프라인; 워크스페이스 Spec만 쓰는 Task는 null)
  projectSpecUploadId String?
  /// 워크스페이스 확정 Spec 버전 출처(업로드 없이 생성 시)
  sourceSpecVersionId String?
  /// 태스크명
  name                String
  /// 설명
  description         String?
  /// 워크플로 DAG 선행 Task id 배열(JSON)
  dependsOnTaskIds    Json?
  /// 수용 기준(실행 루프 평가용, JSON 문자열 배열)
  acceptanceCriteria  Json?
  /// 실행 루프 상태: pending | ready | running | reviewing | done | failed
  executionWorkflowStatus String?
  loopRetryCount      Int               @default(0)
  lastLoopRunAt       DateTime?
  lastEvalResult      String?
  lastEvalSummary     String?           @db.Text
  /// 마지막 오케스트레이션 실행 UI용(비정규화)
  lastOrchestrationBranch            String?
  lastOrchestrationCommitStatus    String?
  lastOrchestrationPushStatus       String?
  lastOrchestrationCommitSha        String?
  lastOrchestrationChangedFileCount Int?
  /// 상태
  status              String            @default("TODO")
  /// 정렬 순서
  order               Int
  /// 상위 태스크 ID(후속 작업)
  parentTaskId        String?
  /// 태스크 종류(PRIMARY 등)
  taskKind            String            @default("PRIMARY")
  /// 변경 사유
  changeReason        String?
  /// 생성일시
  createdAt           DateTime          @default(now())
  /// 수정일시
  updatedAt           DateTime          @updatedAt
  /// 활성 스펙과 불일치·이전 세트 보관 시각(null이면 현재 스펙 TaskSet)
  archivedAt          DateTime?
  /// 소속 프로젝트
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소유 사용자(프로젝트 ownerUserId와 정합)
  taskOwner           User              @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// 스펙 업로드
  projectSpecUpload   ProjectSpecUpload? @relation(fields: [projectSpecUploadId], references: [id], onDelete: Cascade)
  /// Spec 버전 출처
  sourceSpecVersion   ProjectSpecVersion? @relation("TaskSourceSpecVersion", fields: [sourceSpecVersionId], references: [id], onDelete: SetNull)
  /// 상위 태스크
  parentTask          Task?             @relation("TaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  /// 후속 태스크
  followUps           Task[]            @relation("TaskFollowUp")
  /// 프롬프트
  prompts             TaskPrompt[]
  /// 실행 기록
  runs                TaskRun[]
  /// Git 변경 요청
  gitRequests         GitChangeRequest[]
  /// 이력
  histories           TaskHistory[]
  /// 멤버 액션
  memberActions       ProjectMemberAction[]
  /// 오케스트레이션 실행 기록
  taskExecutionRuns   TaskExecutionRun[]

  @@index([projectId, order])
  @@index([projectId, archivedAt])
  @@index([projectSpecUploadId])
  @@index([sourceSpecVersionId])
  @@index([parentTaskId])
  @@index([ownerUserId])
  @@map("tasks")
}

model TaskPrompt {
  /// 프롬프트 ID
  id         String   @id @default(uuid())
  /// 태스크 ID
  taskId     String
  /// 프로젝트 ID
  projectId  String
  /// 프롬프트 본문
  promptText String
  /// 버전
  version    Int
  /// 상태
  status     String   @default("READY")
  /// 생성일시
  createdAt  DateTime @default(now())
  /// 수정일시
  updatedAt  DateTime @updatedAt
  /// 소속 태스크
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 소속 프로젝트
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 실행 기록
  runs       TaskRun[]
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([projectId, createdAt])
  @@map("task_prompts")
}

model TaskRun {
  /// 실행 ID
  id           String     @id @default(uuid())
  /// 태스크 ID
  taskId       String
  /// 프롬프트 ID
  taskPromptId String
  /// 상태
  status       String     @default("PENDING")
  /// 결과 텍스트
  resultText   String?
  /// 결과 JSON
  resultJson   Json?
  /// 생성일시
  createdAt    DateTime   @default(now())
  /// 수정일시
  updatedAt    DateTime   @updatedAt
  /// 소속 태스크
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 사용 프롬프트
  taskPrompt   TaskPrompt @relation(fields: [taskPromptId], references: [id], onDelete: Cascade)
  /// Git 변경 요청
  gitRequests  GitChangeRequest[]
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([taskId, createdAt])
  @@index([taskPromptId])
  @@map("task_runs")
}

model GitChangeRequest {
  /// 요청 ID
  id          String   @id @default(uuid())
  /// 프로젝트 ID
  projectId   String
  /// 태스크 ID
  taskId      String
  /// 태스크 실행 ID
  taskRunId   String
  /// 요청 상태
  status      String   @default("REQUESTED")
  /// 요청 메모
  requestNote String?
  /// 변경 파일 목록(JSON)
  files       Json?
  /// diff 텍스트
  diffText    String?
  /// 커밋 메시지
  commitMessage String?
  /// 반영 상태
  applyStatus String?  @default("PENDING")
  /// 반영 로그
  applyLog    String?
  /// 브랜치명
  branchName        String?
  /// 반영 시작 시각
  applyStartedAt    DateTime?
  /// 반영 종료 시각
  applyFinishedAt   DateTime?
  /// 재시도 횟수
  retryCount  Int      @default(0)
  /// 마지막 오류
  lastError   String?
  /// 마지막 재시도 시각
  lastRetryAt DateTime?
  /// 반려 사유
  rejectionReason String?
  /// Pull Request URL
  pullRequestUrl   String?
  /// Pull Request 번호
  pullRequestNumber Int?
  /// PR 상태(OPEN·CLOSED·MERGED)
  pullRequestState String?
  /// 리뷰 상태 요약
  reviewStatus     String?
  /// 머지 시각
  mergedAt         DateTime?
  /// 생성일시
  createdAt   DateTime @default(now())
  /// 수정일시
  updatedAt   DateTime @updatedAt
  /// 소속 프로젝트
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 태스크
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 소속 실행
  taskRun     TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([taskRunId])
  @@map("git_change_requests")
}

model TaskHistory {
  /// 이력 ID
  id         String   @id @default(uuid())
  /// 프로젝트 ID
  projectId  String
  /// 태스크 ID
  taskId     String
  /// 행위자 유형
  actorType  String
  /// 행위자 ID
  actorId    String?
  /// 이벤트 유형
  eventType  String
  /// 요약
  summary    String?
  /// 상세 JSON
  detailJson Json?
  /// 생성일시
  createdAt  DateTime @default(now())
  /// 소속 프로젝트
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 태스크
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
  @@map("task_histories")
}
