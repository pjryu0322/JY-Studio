generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String             @id @default(uuid())
  name          String
  description   String?
  projectType   String
  repoUrl       String?
  defaultBranch String?
  status        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  uploads       ProjectSpecUpload[]

  @@map("projects")
}

model ProjectSpecUpload {
  id               String   @id @default(uuid())
  projectId        String
  sourceType       String?
  originalFileName String
  fileType         String
  fileSize         Int
  contentText      String?
  contentStored    Boolean  @default(false)
  status           String   @default("REGISTERED")
  parsedJson       Json?
  parseStatus      String?  @default("PENDING")
  parsedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}