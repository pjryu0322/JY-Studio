generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 프로젝트 멤버 역할 구분
enum ProjectMemberRole {
  /// 소유자
  OWNER
  /// 편집자(생성/수정/실행)
  EDITOR
  /// 검토
  REVIEWER
  /// 조회 전용
  VIEWER
}

/// 프로젝트 멤버 유형
enum ProjectMemberType {
  /// 사람 사용자
  HUMAN
  /// AI 멤버
  AI
}

/// AI(또는 멤버) 액션 유형
enum AiMemberActionType {
  /// 코드/변경 리뷰 요청
  REVIEW_REQUEST
  /// Task 초안 생성 요청
  TASK_DRAFT_REQUEST
  /// QA 점검 요청
  QA_CHECK_REQUEST
  /// 요약 요청
  SUMMARY_REQUEST
}

/// AI 멤버 액션 진행 상태
enum AiMemberActionStatus {
  /// 요청됨
  REQUESTED
  /// 진행 중
  IN_PROGRESS
  /// 완료
  DONE
  /// 실패
  FAILED
  /// 취소
  CANCELED
}

/// 실행 모드(스텁·수동·OpenAI·내부 에이전트)
enum AiMemberActionExecutionMode {
  /// 즉시 더미/수동 완료용
  STUB
  /// 내부 워커/운영자 처리
  MANUAL_AGENT
  /// OpenAI 등 외부 LLM 연동(향후)
  OPENAI
  /// 내부 에이전트 실행
  INTERNAL_AGENT
}

model User {
  /// 사용자 ID
  id           String   @id @default(cuid())
  /// 이메일
  email        String   @unique
  /// 비밀번호 해시
  passwordHash String
  /// 사용자 이름
  name         String
  /// 전역 권한
  globalRole   String   @default("USER")
  /// 생성일시
  createdAt    DateTime @default(now())
  /// 수정일시
  updatedAt    DateTime @updatedAt

  /// 소유한 프로젝트 목록
  ownedProjects Project[]
  /// 프로젝트 멤버십 목록
  memberships   ProjectMember[]
  /// 초대한 프로젝트 멤버 목록
  invitedProjectMembers ProjectMember[] @relation("ProjectMemberInvitedBy")
  /// 요청한 AI 멤버 액션 목록
  requestedMemberActions ProjectMemberAction[]
  /// 소유 Task (프로젝트 소유자와 동일한 ownerUserId)
  ownedTasks      Task[]         @relation("TaskOwner")

  @@map("users")
}

model Project {
  /// 프로젝트 ID
  id            String   @id @default(cuid())
  /// 프로젝트명
  name          String
  /// 프로젝트 설명
  description   String?
  /// 소유자 사용자 ID
  ownerUserId   String
  /// 소유자 사용자
  owner         User     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// 프로젝트 유형
  projectType   String
  /// 저장소 URL
  repoUrl       String?
  /// 기본 브랜치
  defaultBranch String?
  /// 프로젝트 상태
  status        String
  /// Git 승인 게이트 모드(NO_APPROVAL·MANUAL_APPROVAL 등)
  gitApprovalMode String           @default("NO_APPROVAL")
  /// Git push 정책(AUTO_PUSH·MANUAL_PUSH)
  gitPushMode     String           @default("AUTO_PUSH")
  /// Task 실행 완료 시 Git 변경 요청 자동 생성 여부
  autoCreateGitRequest Boolean     @default(true)
  /// 생성일시
  createdAt     DateTime           @default(now())
  /// 수정일시
  updatedAt     DateTime           @updatedAt

  /// 업로드된 스펙 파일
  uploads       ProjectSpecUpload[]
  /// 태스크
  tasks         Task[]
  /// 태스크 프롬프트
  taskPrompts   TaskPrompt[]
  /// Git 변경 요청
  gitRequests   GitChangeRequest[]
  /// 프로젝트 멤버
  members       ProjectMember[]
  /// 태스크 이력
  taskHistories TaskHistory[]
  /// 실행 작업
  executionJobs ExecutionJob[]
  /// 실행 이벤트 로그
  executionEventLogs ExecutionEventLog[]
  /// 멤버(주로 AI) 대상 액션 요청
  memberActions ProjectMemberAction[]

  @@index([ownerUserId])
  @@map("projects")
}

model ExecutionJob {
  /// 실행 작업 ID
  id         String    @id @default(uuid())
  /// 프로젝트 ID
  projectId  String
  /// 작업 유형(git-apply·pipeline·cursor)
  type       String
  /// 상태(PENDING·RUNNING·DONE·FAILED)
  status     String    @default("PENDING")
  /// 누적 실패 횟수
  retryCount Int       @default(0)
  /// 최대 시도 횟수
  maxAttempts Int      @default(3)
  /// 실행 페이로드(JSON)
  payload    Json
  /// 실행 결과(JSON)
  result     Json?
  /// 최근 실패 원인
  lastError  String?
  /// 재시도 가능 시각
  availableAt DateTime?
  /// 워커 클레임 식별자
  claimedBy  String?
  /// 하트비트 시각
  heartbeatAt DateTime?
  /// 최종 오류 요약
  error      String?
  /// 시작 시각
  startedAt  DateTime?
  /// 종료 시각
  finishedAt DateTime?
  /// 생성일시
  createdAt  DateTime  @default(now())
  /// 소속 프로젝트
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 이벤트 로그
  eventLogs  ExecutionEventLog[]

  @@index([projectId, status, createdAt])
  @@index([status, createdAt])
  @@index([status, availableAt, createdAt])
  @@map("execution_jobs")
}

model ExecutionEventLog {
  /// 이벤트 로그 ID
  id                 String   @id @default(uuid())
  /// 프로젝트 ID
  projectId          String
  /// 실행 작업 ID
  executionJobId     String
  /// 태스크 ID
  taskId             String?
  /// Git 변경 요청 ID
  gitChangeRequestId String?
  /// 단계(PRECHECK·EXECUTE·APPLY·PR·RETRY·COMPLETE)
  stage              String
  /// 상태(STARTED·SUCCESS·FAILED)
  status             String
  /// 메시지
  message            String?
  /// 실패 유형 분류
  failureType       String?
  /// 상세 JSON
  detailJson         Json?
  /// 소요 시간(ms)
  durationMs         Int?
  /// 생성일시
  createdAt          DateTime @default(now())
  /// 소속 프로젝트
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 실행 작업
  executionJob       ExecutionJob @relation(fields: [executionJobId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([executionJobId])
  @@index([stage])
  @@map("execution_event_logs")
}

model ProjectMember {
  /// 멤버 행 ID
  id        String            @id @default(uuid())
  /// 프로젝트 ID
  projectId String
  /// 사용자 ID(HUMAN일 때 사용)
  userId    String?
  /// 멤버 유형(HUMAN/AI)
  memberType ProjectMemberType @default(HUMAN)
  /// 표시 이름(특히 AI 멤버용)
  displayName String?
  /// AI 제공자(OPENAI/INTERNAL 등)
  aiProvider String?
  /// AI 에이전트 식별 키
  aiAgentKey String?
  /// 초대한 사용자 ID
  invitedByUserId String?
  /// 프로젝트 내 역할
  role      ProjectMemberRole
  /// 생성일시
  createdAt DateTime          @default(now())
  /// 수정일시
  updatedAt DateTime          @updatedAt
  /// 소속 프로젝트
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 연결 사용자(HUMAN 멤버)
  user      User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 초대한 사용자
  invitedBy User?             @relation("ProjectMemberInvitedBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)
  /// 할당된 멤버 액션
  memberActions ProjectMemberAction[]

  @@unique([projectId, userId])
  @@index([projectId, memberType])
  @@index([projectId, role])
  @@map("project_members")
}

/// 프로젝트 멤버(주로 AI)에 대한 협업 액션 요청
model ProjectMemberAction {
  /// 액션 ID
  id           String                  @id @default(uuid())
  /// 프로젝트 ID
  projectId    String
  /// 연결 태스크 ID(선택)
  taskId       String?
  /// 연결 태스크 프롬프트 ID(선택)
  taskPromptId String?
  /// 연결 태스크 실행 ID(선택)
  taskRunId    String?
  /// 연결 Git 변경 요청 ID(선택)
  gitChangeRequestId String?
  /// 대상 프로젝트 멤버 ID(AI 권장, HUMAN 확장 가능)
  projectMemberId String
  /// 액션 유형
  actionType   AiMemberActionType
  /// 상태
  status       AiMemberActionStatus    @default(REQUESTED)
  /// 요청 본문(JSON)
  requestPayload Json?
  /// 결과 본문(JSON)
  resultPayload  Json?
  /// 요청한 사용자 ID(세션 주체)
  requestedByUserId String
  /// 요청 시각
  requestedAt  DateTime                @default(now())
  /// 시작 시각
  startedAt    DateTime?
  /// 종료 시각
  finishedAt   DateTime?
  /// 오류 메시지
  errorMessage String?
  /// 마지막 오류(재시도·디스패처용)
  lastError    String?
  /// 실행 모드
  executionMode AiMemberActionExecutionMode @default(STUB)
  /// 실행기/프로바이더 식별(OPENAI_REVIEWER 등)
  providerKey  String?
  /// 실제 수행한 실행기 이름
  assignedExecutor String?
  /// 재시도 횟수
  retryCount   Int                     @default(0)
  /// 처리 가능 시각(백오프·스케줄)
  availableAt  DateTime?
  /// 디스패처/워커 클레임 식별자
  consumedBy   String?
  /// 상관 키(추적·멱등)
  correlationKey String?
  /// 수정일시
  updatedAt    DateTime                @updatedAt
  /// 소속 프로젝트
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 대상 멤버
  projectMember ProjectMember  @relation(fields: [projectMemberId], references: [id], onDelete: Cascade)
  /// 연결 태스크
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// 연결 프롬프트
  taskPrompt    TaskPrompt?    @relation(fields: [taskPromptId], references: [id], onDelete: SetNull)
  /// 연결 실행
  taskRun       TaskRun?       @relation(fields: [taskRunId], references: [id], onDelete: SetNull)
  /// 연결 Git 변경 요청
  gitChangeRequest GitChangeRequest? @relation(fields: [gitChangeRequestId], references: [id], onDelete: SetNull)
  /// 요청한 사용자
  requestedBy   User           @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)

  @@index([projectId, requestedAt])
  @@index([taskId])
  @@index([projectMemberId])
  @@index([status, availableAt, requestedAt])
  @@map("project_member_actions")
}

model ProjectSpecUpload {
  /// 업로드 ID
  id               String   @id @default(uuid())
  /// 프로젝트 ID
  projectId        String
  /// 소스 유형
  sourceType       String?
  /// 원본 파일명
  originalFileName String
  /// 파일 MIME/유형
  fileType         String
  /// 파일 크기(바이트)
  fileSize         Int
  /// 본문 텍스트(선택)
  contentText      String?
  /// 본문 저장 여부
  contentStored    Boolean  @default(false)
  /// 업로드 상태
  status           String   @default("REGISTERED")
  /// 파싱 결과 JSON
  parsedJson       Json?
  /// 파싱 상태
  parseStatus      String?  @default("PENDING")
  /// 파싱 완료 시각
  parsedAt         DateTime?
  /// 생성일시
  createdAt        DateTime @default(now())
  /// 수정일시
  updatedAt        DateTime @updatedAt
  /// 소속 프로젝트
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 파생 태스크
  tasks            Task[]

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}

model Task {
  /// 태스크 ID
  id                  String            @id @default(uuid())
  /// 프로젝트 ID
  projectId           String
  /// 태스크 소유 사용자 ID(프로젝트 소유자와 동일해야 함)
  ownerUserId         String
  /// 스펙 업로드 ID
  projectSpecUploadId String
  /// 태스크명
  name                String
  /// 설명
  description         String?
  /// 상태
  status              String            @default("TODO")
  /// 정렬 순서
  order               Int
  /// 상위 태스크 ID(후속 작업)
  parentTaskId        String?
  /// 태스크 종류(PRIMARY 등)
  taskKind            String            @default("PRIMARY")
  /// 변경 사유
  changeReason        String?
  /// 생성일시
  createdAt           DateTime          @default(now())
  /// 수정일시
  updatedAt           DateTime          @updatedAt
  /// 소속 프로젝트
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소유 사용자(프로젝트 ownerUserId와 정합)
  taskOwner           User              @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  /// 스펙 업로드
  projectSpecUpload   ProjectSpecUpload @relation(fields: [projectSpecUploadId], references: [id], onDelete: Cascade)
  /// 상위 태스크
  parentTask          Task?             @relation("TaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  /// 후속 태스크
  followUps           Task[]            @relation("TaskFollowUp")
  /// 프롬프트
  prompts             TaskPrompt[]
  /// 실행 기록
  runs                TaskRun[]
  /// Git 변경 요청
  gitRequests         GitChangeRequest[]
  /// 이력
  histories           TaskHistory[]
  /// 멤버 액션
  memberActions       ProjectMemberAction[]

  @@index([projectId, order])
  @@index([projectSpecUploadId])
  @@index([parentTaskId])
  @@index([ownerUserId])
  @@map("tasks")
}

model TaskPrompt {
  /// 프롬프트 ID
  id         String   @id @default(uuid())
  /// 태스크 ID
  taskId     String
  /// 프로젝트 ID
  projectId  String
  /// 프롬프트 본문
  promptText String
  /// 버전
  version    Int
  /// 상태
  status     String   @default("READY")
  /// 생성일시
  createdAt  DateTime @default(now())
  /// 수정일시
  updatedAt  DateTime @updatedAt
  /// 소속 태스크
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 소속 프로젝트
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 실행 기록
  runs       TaskRun[]
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([projectId, createdAt])
  @@map("task_prompts")
}

model TaskRun {
  /// 실행 ID
  id           String     @id @default(uuid())
  /// 태스크 ID
  taskId       String
  /// 프롬프트 ID
  taskPromptId String
  /// 상태
  status       String     @default("PENDING")
  /// 결과 텍스트
  resultText   String?
  /// 결과 JSON
  resultJson   Json?
  /// 생성일시
  createdAt    DateTime   @default(now())
  /// 수정일시
  updatedAt    DateTime   @updatedAt
  /// 소속 태스크
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 사용 프롬프트
  taskPrompt   TaskPrompt @relation(fields: [taskPromptId], references: [id], onDelete: Cascade)
  /// Git 변경 요청
  gitRequests  GitChangeRequest[]
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([taskId, createdAt])
  @@index([taskPromptId])
  @@map("task_runs")
}

model GitChangeRequest {
  /// 요청 ID
  id          String   @id @default(uuid())
  /// 프로젝트 ID
  projectId   String
  /// 태스크 ID
  taskId      String
  /// 태스크 실행 ID
  taskRunId   String
  /// 요청 상태
  status      String   @default("REQUESTED")
  /// 요청 메모
  requestNote String?
  /// 변경 파일 목록(JSON)
  files       Json?
  /// diff 텍스트
  diffText    String?
  /// 커밋 메시지
  commitMessage String?
  /// 반영 상태
  applyStatus String?  @default("PENDING")
  /// 반영 로그
  applyLog    String?
  /// 브랜치명
  branchName        String?
  /// 반영 시작 시각
  applyStartedAt    DateTime?
  /// 반영 종료 시각
  applyFinishedAt   DateTime?
  /// 재시도 횟수
  retryCount  Int      @default(0)
  /// 마지막 오류
  lastError   String?
  /// 마지막 재시도 시각
  lastRetryAt DateTime?
  /// 반려 사유
  rejectionReason String?
  /// Pull Request URL
  pullRequestUrl   String?
  /// Pull Request 번호
  pullRequestNumber Int?
  /// PR 상태(OPEN·CLOSED·MERGED)
  pullRequestState String?
  /// 리뷰 상태 요약
  reviewStatus     String?
  /// 머지 시각
  mergedAt         DateTime?
  /// 생성일시
  createdAt   DateTime @default(now())
  /// 수정일시
  updatedAt   DateTime @updatedAt
  /// 소속 프로젝트
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 태스크
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// 소속 실행
  taskRun     TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)
  /// 멤버 액션
  memberActions ProjectMemberAction[]

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([taskRunId])
  @@map("git_change_requests")
}

model TaskHistory {
  /// 이력 ID
  id         String   @id @default(uuid())
  /// 프로젝트 ID
  projectId  String
  /// 태스크 ID
  taskId     String
  /// 행위자 유형
  actorType  String
  /// 행위자 ID
  actorId    String?
  /// 이벤트 유형
  eventType  String
  /// 요약
  summary    String?
  /// 상세 JSON
  detailJson Json?
  /// 생성일시
  createdAt  DateTime @default(now())
  /// 소속 프로젝트
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// 소속 태스크
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
  @@map("task_histories")
}
