generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectMemberRole {
  OWNER
  PLANNER
  REVIEWER
  OPERATOR
}

model Project {
  id            String             @id @default(uuid())
  name          String
  description   String?
  projectType   String
  repoUrl       String?
  defaultBranch String?
  status        String
  /**
   * 승인 게이트만 담당 (GCR status·승인 API). push·원격 반영과 무관.
   * NO_APPROVAL(기본) | MANUAL_APPROVAL. 레거시 AUTO_APPLY = NO_APPROVAL.
   */
  gitApprovalMode String           @default("NO_APPROVAL")
  /**
   * 원격 push 시도 여부만 담당 (git-apply options.push 기본값). 승인과 무관.
   * AUTO_PUSH(기본) | MANUAL_PUSH.
   */
  gitPushMode     String           @default("AUTO_PUSH")
  /** Task mock 실행 완료 시 Run→GitChangeRequest 자동 생성 여부 */
  autoCreateGitRequest Boolean     @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  uploads       ProjectSpecUpload[]
  tasks         Task[]
  taskPrompts   TaskPrompt[]
  gitRequests   GitChangeRequest[]
  members       ProjectMember[]
  taskHistories TaskHistory[]
  executionJobs ExecutionJob[]

  @@map("projects")
}

model ExecutionJob {
  id         String    @id @default(uuid())
  projectId  String
  /** git-apply | pipeline | cursor */
  type       String
  /** PENDING | RUNNING | DONE | FAILED */
  status     String    @default("PENDING")
  payload    Json
  result     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status, createdAt])
  @@index([status, createdAt])
  @@map("execution_jobs")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectSpecUpload {
  id               String   @id @default(uuid())
  projectId        String
  sourceType       String?
  originalFileName String
  fileType         String
  fileSize         Int
  contentText      String?
  contentStored    Boolean  @default(false)
  status           String   @default("REGISTERED")
  parsedJson       Json?
  parseStatus      String?  @default("PENDING")
  parsedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}

model Task {
  id                  String            @id @default(uuid())
  projectId           String
  projectSpecUploadId String
  name                String
  description         String?
  status              String            @default("TODO")
  order               Int
  parentTaskId        String?
  taskKind            String            @default("PRIMARY")
  changeReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSpecUpload   ProjectSpecUpload @relation(fields: [projectSpecUploadId], references: [id], onDelete: Cascade)
  parentTask          Task?             @relation("TaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  followUps           Task[]            @relation("TaskFollowUp")
  prompts             TaskPrompt[]
  runs                TaskRun[]
  gitRequests         GitChangeRequest[]
  histories           TaskHistory[]

  @@index([projectId, order])
  @@index([projectSpecUploadId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskPrompt {
  id         String   @id @default(uuid())
  taskId     String
  projectId  String
  promptText String
  version    Int
  status     String   @default("READY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs       TaskRun[]

  @@index([projectId, createdAt])
  @@map("task_prompts")
}

model TaskRun {
  id           String     @id @default(uuid())
  taskId       String
  taskPromptId String
  status       String     @default("PENDING")
  resultText   String?
  /** 구조화 실행 결과(JSON). resultText는 하위호환용으로 유지. */
  resultJson   Json?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskPrompt   TaskPrompt @relation(fields: [taskPromptId], references: [id], onDelete: Cascade)
  gitRequests  GitChangeRequest[]

  @@index([taskId, createdAt])
  @@index([taskPromptId])
  @@map("task_runs")
}

model GitChangeRequest {
  id          String   @id @default(uuid())
  projectId   String
  taskId      String
  taskRunId   String
  status      String   @default("REQUESTED")
  requestNote String?
  files       Json?
  diffText    String?
  commitMessage String?
  applyStatus String?  @default("PENDING")
  applyLog    String?
  branchName        String?
  applyStartedAt    DateTime?
  applyFinishedAt   DateTime?
  retryCount  Int      @default(0)
  lastError   String?
  lastRetryAt DateTime?
  rejectionReason String?
  pullRequestUrl   String?
  pullRequestNumber Int?
  /** OPEN | CLOSED | MERGED (GitHub PR state 정규화) */
  pullRequestState String?
  /** PENDING | APPROVED | CHANGES_REQUESTED (리뷰 요약) */
  reviewStatus     String?
  mergedAt         DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRun     TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([taskRunId])
  @@map("git_change_requests")
}

model TaskHistory {
  id         String   @id @default(uuid())
  projectId  String
  taskId     String
  actorType  String
  actorId    String?
  eventType  String
  summary    String?
  detailJson Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
  @@map("task_histories")
}