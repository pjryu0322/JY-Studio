generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectMemberRole {
  OWNER
  PLANNER
  REVIEWER
  OPERATOR
}

model Project {
  id            String             @id @default(uuid())
  name          String
  description   String?
  projectType   String
  repoUrl       String?
  defaultBranch String?
  status        String
  /** AUTO_APPLY: Git 반영 즉시 가능(기본). MANUAL_APPROVAL: 승인 게이트 필요. */
  gitApprovalMode String           @default("AUTO_APPLY")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  uploads       ProjectSpecUpload[]
  tasks         Task[]
  taskPrompts   TaskPrompt[]
  gitRequests   GitChangeRequest[]
  members       ProjectMember[]
  taskHistories TaskHistory[]

  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(uuid())
  projectId String
  userId    String
  role      ProjectMemberRole
  createdAt DateTime          @default(now())
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model ProjectSpecUpload {
  id               String   @id @default(uuid())
  projectId        String
  sourceType       String?
  originalFileName String
  fileType         String
  fileSize         Int
  contentText      String?
  contentStored    Boolean  @default(false)
  status           String   @default("REGISTERED")
  parsedJson       Json?
  parseStatus      String?  @default("PENDING")
  parsedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}

model Task {
  id                  String            @id @default(uuid())
  projectId           String
  projectSpecUploadId String
  name                String
  description         String?
  status              String            @default("TODO")
  order               Int
  parentTaskId        String?
  taskKind            String            @default("PRIMARY")
  changeReason        String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSpecUpload   ProjectSpecUpload @relation(fields: [projectSpecUploadId], references: [id], onDelete: Cascade)
  parentTask          Task?             @relation("TaskFollowUp", fields: [parentTaskId], references: [id], onDelete: SetNull)
  followUps           Task[]            @relation("TaskFollowUp")
  prompts             TaskPrompt[]
  runs                TaskRun[]
  gitRequests         GitChangeRequest[]
  histories           TaskHistory[]

  @@index([projectId, order])
  @@index([projectSpecUploadId])
  @@index([parentTaskId])
  @@map("tasks")
}

model TaskPrompt {
  id         String   @id @default(uuid())
  taskId     String
  projectId  String
  promptText String
  version    Int
  status     String   @default("READY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs       TaskRun[]

  @@index([projectId, createdAt])
  @@map("task_prompts")
}

model TaskRun {
  id           String     @id @default(uuid())
  taskId       String
  taskPromptId String
  status       String     @default("PENDING")
  resultText   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskPrompt   TaskPrompt @relation(fields: [taskPromptId], references: [id], onDelete: Cascade)
  gitRequests  GitChangeRequest[]

  @@index([taskId, createdAt])
  @@index([taskPromptId])
  @@map("task_runs")
}

model GitChangeRequest {
  id          String   @id @default(uuid())
  projectId   String
  taskId      String
  taskRunId   String
  status      String   @default("REQUESTED")
  requestNote String?
  files       Json?
  diffText    String?
  commitMessage String?
  applyStatus String?  @default("PENDING")
  applyLog    String?
  branchName        String?
  applyStartedAt    DateTime?
  applyFinishedAt   DateTime?
  retryCount  Int      @default(0)
  lastError   String?
  lastRetryAt DateTime?
  rejectionReason String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskRun     TaskRun  @relation(fields: [taskRunId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([taskId])
  @@index([taskRunId])
  @@map("git_change_requests")
}

model TaskHistory {
  id         String   @id @default(uuid())
  projectId  String
  taskId     String
  actorType  String
  actorId    String?
  eventType  String
  summary    String?
  detailJson Json?
  createdAt  DateTime @default(now())
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([projectId, taskId, createdAt])
  @@map("task_histories")
}