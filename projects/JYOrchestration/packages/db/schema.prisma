generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String             @id @default(uuid())
  name          String
  description   String?
  projectType   String
  repoUrl       String?
  defaultBranch String?
  status        String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  uploads       ProjectSpecUpload[]
  tasks         Task[]
  taskPrompts   TaskPrompt[]

  @@map("projects")
}

model ProjectSpecUpload {
  id               String   @id @default(uuid())
  projectId        String
  sourceType       String?
  originalFileName String
  fileType         String
  fileSize         Int
  contentText      String?
  contentStored    Boolean  @default(false)
  status           String   @default("REGISTERED")
  parsedJson       Json?
  parseStatus      String?  @default("PENDING")
  parsedAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks            Task[]

  @@index([projectId, createdAt])
  @@map("project_spec_uploads")
}

model Task {
  id                  String            @id @default(uuid())
  projectId           String
  projectSpecUploadId String
  name                String
  description         String?
  status              String            @default("TODO")
  order               Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectSpecUpload   ProjectSpecUpload @relation(fields: [projectSpecUploadId], references: [id], onDelete: Cascade)
  prompts             TaskPrompt[]
  runs                TaskRun[]

  @@index([projectId, order])
  @@index([projectSpecUploadId])
  @@map("tasks")
}

model TaskPrompt {
  id         String   @id @default(uuid())
  taskId     String
  projectId  String
  promptText String
  version    Int
  status     String   @default("READY")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs       TaskRun[]

  @@index([projectId, createdAt])
  @@map("task_prompts")
}

model TaskRun {
  id           String     @id @default(uuid())
  taskId       String
  taskPromptId String
  status       String     @default("PENDING")
  resultText   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  task         Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskPrompt   TaskPrompt @relation(fields: [taskPromptId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([taskPromptId])
  @@map("task_runs")
}