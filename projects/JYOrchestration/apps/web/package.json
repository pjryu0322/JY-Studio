{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:generate": "prisma generate --schema=../../packages/db/schema.prisma",
    "db:migrate": "dotenv -e ../../.env -e .env.local -- prisma migrate deploy --schema=../../packages/db/schema.prisma",
    "db:migrate:status": "dotenv -e ../../.env -e .env.local -- prisma migrate status --schema=../../packages/db/schema.prisma",
    "db:fix:execution-setup-columns": "dotenv -e ../../.env -e .env.local -- prisma db execute --file ../../scripts/ensure-execution-setup-split-columns.sql --schema ../../packages/db/schema.prisma",
    "postinstall": "prisma generate --schema=../../packages/db/schema.prisma",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:api": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@prisma/client": "6.16.0",
    "bcryptjs": "^3.0.3",
    "dagre": "^0.8.5",
    "jose": "^6.2.2",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/dagre": "^0.7.54",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prisma": "6.16.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
