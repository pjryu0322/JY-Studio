{
  "name": "jykstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k --success first -n minio,web,docling,search-data -c yellow,cyan,magenta,green \"npm run dev:minio\" \"npm run dev:web\" \"npm run dev:worker\" \"npm run dev:search-worker\"",
    "dev:minio": "node scripts/dev-minio.mjs",
    "dev:web": "node -e \"console.log('JYKStore started on port 3004')\" && next dev -p 3004",
    "dev:worker": "tsx src/workers/docling-processing-worker.ts",
    "dev:search-worker": "tsx src/workers/search-data-generation-worker.ts",
    "dev:embedding-worker": "node scripts/run-embedding-worker-stub.mjs",
    "embedding-model:install": "node scripts/run-embedding-model-install.mjs",
    "embedding-model:status": "node scripts/run-embedding-model-status.mjs",
    "embedding-model:verify": "node scripts/run-embedding-model-verify.mjs",
    "embedding-worker:start:live": "node scripts/run-embedding-worker-live.mjs",
    "embedding-worker:test:stub": "node scripts/run-embedding-worker-pytest.mjs stub",
    "embedding-worker:test:live": "node scripts/run-embedding-worker-pytest.mjs live",
    "embedding-worker:benchmark:live": "node scripts/run-embedding-worker-benchmark.mjs",
    "benchmark:e5-worker": "node scripts/benchmark-e5-worker.mjs",
    "minio:up": "node scripts/dev-minio.mjs",
    "worker:docling": "tsx src/workers/docling-processing-worker.ts",
    "worker:search-data": "tsx src/workers/search-data-generation-worker.ts",
    "smoke:dev-processes": "tsx scripts/smoke-dev-processes.ts",
    "build": "next build",
    "start": "next start -p 3004",
    "lint": "next lint",
    "test": "node scripts/run-unit-tests.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "test:payload-storage": "node --import tsx --test src/__tests__/p29-1-object-storage-hardening.test.ts src/__tests__/s3-payload-storage.mock.test.ts src/__tests__/p29-2-distribution-consistency.test.ts src/__tests__/my-packs-distribution-visibility.test.ts src/__tests__/distribution-e2e-safety-guard.test.ts src/__tests__/my-packs-version-history.test.ts src/__tests__/invalid-distribution-state.test.ts src/__tests__/latest-pack-artifact-state.test.ts src/__tests__/public-pack-capability.test.ts",
    "test:pack-capability-e2e": "node --import tsx --test src/__tests__/public-pack-capability.test.ts src/__tests__/context-public-api-route-smoke.test.ts",
    "test:public-download-unit": "node --import tsx --test src/__tests__/public-download-integrity.test.ts src/__tests__/pack-detail-ux.test.ts src/__tests__/select-public-artifact.test.ts src/__tests__/distribution-metadata-patch.test.ts",
    "test:public-download-e2e": "node --import tsx --test src/__tests__/public-download-integrity.test.ts",
    "test:public-download-e2e:full": "node test/run-public-download-e2e.mjs",
    "test:s3-integration": "node --import tsx --test src/__tests__/s3-payload-storage.integration.test.ts",
    "test:distribution-e2e": "node --import tsx --test src/__tests__/invalid-distribution-state.test.ts src/__tests__/latest-pack-artifact-state.test.ts",
    "test:distribution-e2e:up": "docker compose -f test/docker-compose.distribution-e2e.yml up -d --wait",
    "test:distribution-e2e:down": "docker compose -f test/docker-compose.distribution-e2e.yml down -v",
    "test:distribution-e2e:full": "node test/run-distribution-e2e.mjs",
    "test:docling-e2e": "node --import tsx --test src/__tests__/docling-minio-e2e.test.ts",
    "test:docling-e2e:full": "node test/run-docling-e2e.mjs",
    "test:docling-large-upload-e2e": "node --import tsx --test src/__tests__/docling-large-upload-e2e.test.ts",
    "test:docling-upload-hardening": "node --import tsx --test src/__tests__/docling-json-stream-projector.test.ts src/__tests__/docling-upload-hardening.test.ts src/__tests__/docling-upload-session.test.ts src/__tests__/docling-large-path-static.test.ts src/__tests__/service-channels-and-validation-flow.test.ts src/__tests__/service-validation-p0-security.test.ts src/__tests__/service-validation-provider-quality.test.ts src/__tests__/service-validation-share-and-evidence.test.ts",
    "test:docling-markdown-optional": "node --import tsx --test src/__tests__/docling-markdown-validator.test.ts src/__tests__/docling-markdown-optional.test.ts",
    "test:pack-language": "node --import tsx --test src/__tests__/pack-language.test.ts src/__tests__/p29-b-distribution-foundation.test.ts src/__tests__/docling-import-service.test.ts",
    "test:docling-revalidation-e2e": "node --import tsx --test src/__tests__/docling-revalidation-e2e.test.ts",
    "mcp:stdio": "tsx mcp-server/server.ts --transport stdio",
    "mcp:http": "tsx mcp-server/server.ts --transport http",
    "mcp:test": "node --import tsx --test src/__tests__/mcp-*.test.ts",
    "mcp:test:runtime": "node --import tsx --test src/__tests__/mcp-*-runtime.test.ts src/__tests__/mcp-registration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "cleanup:legacy-zip-payloads": "tsx scripts/cleanup-legacy-zip-payloads.ts",
    "backfill:search-generations": "tsx scripts/backfill-search-generations.ts",
    "test:db:service-validation": "node --import tsx --test src/__tests__/latest-pipeline-open-review.db.test.ts src/__tests__/service-validation-final-followup.db.test.ts",
    "test:db:search-scaffold": "node --import tsx --test src/__tests__/search-data-scaffold-enqueue.db.test.ts src/__tests__/source-change-stale.db.test.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1086.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.16.0",
    "jszip": "^3.10.1",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stream-json": "^3.5.0",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/stream-json": "^1.7.8",
    "@types/yauzl": "^3.4.0",
    "concurrently": "^10.0.3",
    "eslint": "^9",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5"
  }
}
