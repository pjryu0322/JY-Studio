generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackStatus {
  DRAFT
  REVIEWING
  VERIFIED
  PUBLISHED
  DEPRECATED
  SUSPENDED
}

enum PackPricing {
  FREE
  PAID
  ENTERPRISE
}

enum ProviderType {
  JYK_VERIFIED
  OFFICIAL
  COMMUNITY
}

enum InstallationStatus {
  ACTIVE
  REMOVED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum SourceType {
  PRODUCT_MANUAL
  INTEGRATION_GUIDE
  API_SPEC
  OPENAPI_SCHEMA
  ERROR_CODE_TABLE
  SAMPLE_CODE
  FAQ
  RELEASE_NOTE
  SECURITY_GUIDE
  TEST_ENV_GUIDE
  OPERATION_GUIDE
  CALLBACK_GUIDE
  TROUBLESHOOTING
  ETC
}

enum SourceFormat {
  TEXT
  MARKDOWN
  HTML
  PDF
  DOCX
  XLSX
  CSV
  JSON
  YAML
  OPENAPI_JSON
  OPENAPI_YAML
  CODE
  URL
  ETC
}

enum SourceValidationStatus {
  NOT_CHECKED
  PASS
  WARNING
  FAIL
}

enum PipelineStatus {
  SOURCE_REGISTERING
  SOURCE_VALIDATING
  STRUCTURING
  STRUCTURE_VALIDATING
  KNOWLEDGE_CHECKING
  CHUNKING
  CHUNK_EVALUATING
  INDEXING
  SEARCH_EVALUATING
  RELEASE_CHECKING
  READY_FOR_REVIEW
  REVIEWING
  APPROVED
  PUBLISHED
  FAILED
}

enum PipelineStepStatus {
  PENDING
  RUNNING
  PASS
  WARNING
  FAIL
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  DEPRECATE
  SUSPEND
  INSTALL
  REMOVE
  API_KEY_CREATE
  API_KEY_REVOKE
  API_KEY_VERIFY_FAILED
  API_KEY_EXPIRED
  API_KEY_SCOPE_DENIED
  PROVIDER_PROFILE_UPSERT
  PROVIDER_PACK_CREATE
  PROVIDER_PACK_UPDATE
  PROVIDER_PACK_VERSION_CREATE
  PROVIDER_SOURCE_DOCUMENT_CREATE
  PROVIDER_PACK_SUBMIT
  ADMIN_REVIEW_CREATE
  ADMIN_REVIEW_UPDATE
  ADMIN_PACK_APPROVE
  ADMIN_PACK_REJECT
  ADMIN_CHUNK_CREATE
  ADMIN_CHUNK_UPDATE
  ADMIN_CHUNK_DEACTIVATE
  ADMIN_CHUNK_GENERATE
  ADMIN_RELEASE_GATE_EVALUATE
  PAYLOAD_UPLOADED
  PAYLOAD_DELETED
  PAYLOAD_VALIDATED
  DISTRIBUTION_METADATA_UPDATED
  DISTRIBUTION_SUBMITTED
  PAYLOAD_DOWNLOADED
  DOCLING_IMPORT_UPLOADED
  DOCLING_IMPORT_VALIDATED
  DOCLING_IMPORT_NORMALIZED
  DOCLING_IMPORT_DELETED
  DOCLING_IMPORT_RETRIED
  DOCLING_REVIEW_INTEGRITY_VERIFIED
  DOCLING_REVIEW_INTEGRITY_FAILED
}

model ProviderProfile {
  id             String   @id @default(cuid())
  clientId       String?  @unique
  userId         String?
  organizationId String?
  displayName    String
  description    String
  websiteUrl     String?
  contactEmail   String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  packs        KnowledgePack[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model User {
  id          String   @id @default(cuid())
  email       String?  @unique
  name        String?
  /// USER | PROVIDER | ADMIN — ADMIN grants admin console access.
  accountRole String   @default("USER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   OrganizationMember[]
  installations PackInstallation[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  providerProfiles ProviderProfile[]

  @@index([accountRole])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  installations PackInstallation[]
  apiKeys       ApiKey[]
  providerProfiles ProviderProfile[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model PackCategory {
  id          String   @id @default(cuid())
  categoryId  String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packs KnowledgePack[]
}

model KnowledgePack {
  id                String       @id @default(cuid())
  packId            String       @unique
  name              String
  categoryId        String
  providerName      String
  providerType      ProviderType
  providerProfileId String?
  status            PackStatus
  pricing          PackPricing
  icon             String
  shortDescription String
  description      String
  tags             String[]
  rating           Float        @default(0)
  usageCount       Int          @default(0)
  isVerified       Boolean      @default(false)
  pipelineStatus    PipelineStatus @default(SOURCE_REGISTERING)
  pipelineUpdatedAt DateTime?
  structureTemplateKey String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  category        PackCategory           @relation(fields: [categoryId], references: [categoryId])
  providerProfile ProviderProfile?       @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  versions        KnowledgePackVersion[]
  installations PackInstallation[]
  usageLogs     ApiUsageLog[]
  reviews       PackReview[]
  graphNodes    KnowledgeGraphNode[]
  graphEdges    KnowledgeGraphEdge[]
  pipelineRuns     PipelineRun[]
  pipelineStepLogs PipelineStepLog[]
  sourceValidationReports SourceValidationReport[]
  structureCoverageReports StructureCoverageReport[]
  knowledgeQualityReports  KnowledgeQualityReport[]
  chunkQualityReports      ChunkQualityReport[]
  retrievalEvaluationSets    RetrievalEvaluationSet[]
  retrievalEvaluationRuns    RetrievalEvaluationRun[]
  retrievalEvaluationCases   RetrievalEvaluationCase[]
  retrievalEvaluationResults RetrievalEvaluationResult[]
  releaseGateRuns          ReleaseGateRun[]
  payloads                 KnowledgePayload[]
  distributionMetadata     PackDistributionMetadata[]
  doclingImportBundles     DoclingImportBundle[]
  knowledgePackFiles        KnowledgePackFile[]
  normalizedDocuments      NormalizedDocument[]

  @@index([status])
  @@index([categoryId])
  @@index([providerProfileId])
  @@index([pipelineStatus])
}

model PackReview {
  id               String    @id @default(cuid())
  packId           String
  reviewerClientId String?
  reviewerUserId   String?
  status           String
  decision         String?
  memo             String?
  rejectionReason  String?
  submitSnapshot   Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  decidedAt        DateTime?

  pack KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@index([packId])
  @@index([status])
  @@index([decision])
  @@index([createdAt])
  @@index([reviewerUserId])
}

model KnowledgePackVersion {
  id                    String   @id @default(cuid())
  packId                String
  version               String
  overview              String
  features              String[]
  includedKnowledge     String[]
  supportedEnvironments String[]
  targetUsers           String[]
  useCases              String[]
  versionSummary        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pack            KnowledgePack    @relation(fields: [packId], references: [packId], onDelete: Cascade)
  sourceDocuments SourceDocument[]
  chunks          KnowledgeChunk[]
  embeddings      KnowledgeChunkEmbedding[]
  graphNodes      KnowledgeGraphNode[]
  graphEdges      KnowledgeGraphEdge[]
  sourceValidationReports SourceValidationReport[]
  structureCoverageReports StructureCoverageReport[]
  knowledgeQualityReports  KnowledgeQualityReport[]
  chunkQualityReports      ChunkQualityReport[]
  retrievalEvaluationSets    RetrievalEvaluationSet[]
  retrievalEvaluationRuns    RetrievalEvaluationRun[]
  retrievalEvaluationCases   RetrievalEvaluationCase[]
  retrievalEvaluationResults RetrievalEvaluationResult[]
  payload                    KnowledgePayload?
  distributionMetadata       PackDistributionMetadata?
  doclingImportBundles       DoclingImportBundle[]
  knowledgePackFiles          KnowledgePackFile[]
  normalizedDocuments        NormalizedDocument[]

  @@unique([packId, version])
  @@index([packId])
}

enum PayloadGeneratorType {
  DOCLING
  UNSTRUCTURED
}

enum PayloadValidationStatus {
  PENDING
  VALID
  INVALID
}

enum DistributionVisibility {
  PRIVATE
  PUBLIC
  UNLISTED
}

model KnowledgePayload {
  id                String                  @id @default(cuid())
  packId            String
  versionId         String
  profile           String
  generatorType     PayloadGeneratorType
  generatorVersion  String?
  originalFileName  String
  /// S3-compatible object key (not a local filesystem path).
  storagePath       String
  mimeType          String
  fileSize          BigInt
  checksumSha256    String
  validationStatus  PayloadValidationStatus @default(PENDING)
  validationMessage String?
  validationReport  Json?
  manifestJson      Json?
  isImmutable       Boolean                 @default(true)
  uploadedAt        DateTime                @default(now())
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  pack    KnowledgePack        @relation(fields: [packId], references: [packId], onDelete: Restrict)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId])
  @@index([packId])
  @@index([checksumSha256])
}

enum PayloadCleanupStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model PayloadStorageCleanupJob {
  id                  String               @id @default(cuid())
  objectKey           String
  payloadId           String?
  /// Optional link for Docling pack-file cleanup status sync.
  doclingBundleId     String?
  knowledgePackFileId String?
  reason              String
  status              PayloadCleanupStatus @default(PENDING)
  attemptCount        Int                  @default(0)
  lastError           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?

  @@index([status, createdAt])
  @@index([objectKey])
  @@index([doclingBundleId, status])
}

model PackDistributionMetadata {
  id            String                 @id @default(cuid())
  packId        String
  versionId     String
  sourceTitle   String?
  sourceUrl     String?
  licenseName   String
  licenseUrl    String?
  usageTerms    String?
  readmeText    String?
  visibility    DistributionVisibility @default(PRIVATE)
  allowDownload Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  pack    KnowledgePack        @relation(fields: [packId], references: [packId], onDelete: Restrict)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId])
  @@index([packId])
}

enum DoclingImportBundleStatus {
  UPLOADED
  VALIDATING
  VALIDATION_FAILED
  VALID
  NORMALIZING
  NORMALIZED
  NORMALIZATION_FAILED
  REVIEW_READY
}

enum KnowledgePackFileRole {
  SOURCE_ORIGINAL
  DOCLING_JSON
  DOCLING_MARKDOWN
}

enum DoclingProcessingStage {
  UPLOAD
  VALIDATION
  NORMALIZATION
  RETRY
}

enum DoclingProcessingStatus {
  STARTED
  SUCCEEDED
  FAILED
}

enum DoclingBundleStorageStatus {
  ACTIVE
  DELETE_PENDING
  DELETED
  DELETE_FAILED
}

/// Three-file Docling import unit (source + JSON + Markdown). Separate from ZIP KnowledgePayload.
model DoclingImportBundle {
  id                    String                    @id @default(cuid())
  packId                String
  versionId             String
  status                DoclingImportBundleStatus @default(UPLOADED)
  isActive              Boolean                   @default(false)
  adapterType           String                    @default("DOCLING")
  adapterVersion        String                    @default("1.0.0")
  doclingSchemaName     String?
  doclingSchemaVersion  String?
  validationReport      Json?
  normalizationReport   Json?
  warningCount          Int                       @default(0)
  errorCount            Int                       @default(0)
  lastErrorCode         String?
  lastErrorMessage      String?
  uploadedByUserId      String?
  validatedAt           DateTime?
  normalizedAt          DateTime?
  reviewReadyAt         DateTime?
  /// Soft-deactivation timestamp when replaced or deleted (audit retention).
  deactivatedAt         DateTime?
  deactivationReason    String?
  replacedByBundleId    String?
  deletedAt             DateTime?
  storageStatus         DoclingBundleStorageStatus @default(ACTIVE)
  storageDeleteAttempts Int                        @default(0)
  storageLastError      String?
  /// Optional staging expiry hint (TTL cleanup is out of scope for P0-A.2).
  expiresAt             DateTime?
  stagingReason         String?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  pack                 KnowledgePack          @relation(fields: [packId], references: [packId], onDelete: Restrict)
  version              KnowledgePackVersion   @relation(fields: [versionId], references: [id], onDelete: Restrict)
  files                KnowledgePackFile[]
  normalizedDocuments  NormalizedDocument[]
  processingLogs       DoclingProcessingLog[]

  @@index([packId, versionId])
  @@index([versionId, isActive])
  @@index([status])
  @@index([storageStatus])
  /// Partial unique: one active bundle per version — enforced in migration SQL:
  /// CREATE UNIQUE INDEX "DoclingImportBundle_one_active_per_version" ON "DoclingImportBundle" ("versionId") WHERE "isActive" = true;
}

/// Immutable per-role file object for a Docling import bundle.
model KnowledgePackFile {
  id               String                @id @default(cuid())
  bundleId         String
  packId           String
  versionId        String
  role             KnowledgePackFileRole
  storageKey       String
  originalFileName String
  mimeType         String
  fileExtension    String
  fileSize         BigInt
  checksumSha256   String
  isImmutable      Boolean               @default(true)
  uploadedByUserId String?
  uploadedAt       DateTime              @default(now())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  bundle  DoclingImportBundle  @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  pack    KnowledgePack         @relation(fields: [packId], references: [packId], onDelete: Restrict)
  version KnowledgePackVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([bundleId, role])
  @@index([packId, versionId])
  @@index([checksumSha256])
  @@index([storageKey])
}

/// Regenerable Store-derived document structure from Docling JSON (+ Markdown assist).
model NormalizedDocument {
  id                     String   @id @default(cuid())
  bundleId               String
  packId                 String
  versionId              String
  isActive               Boolean  @default(true)
  adapterType            String   @default("DOCLING")
  adapterVersion         String
  sourceSchemaName       String?
  sourceSchemaVersion    String?
  title                  String?
  language               String?
  structureJson          Json?
  sectionsJson           Json?
  tablesJson             Json?
  figuresJson            Json?
  readingOrderJson       Json?
  warningsJson           Json?
  sourceFileId           String?
  jsonPayloadFileId      String?
  markdownPayloadFileId  String?
  sourcePayloadChecksum  String?
  fingerprint            String?
  /// Canonical fingerprint algorithm id (e.g. normalized-document-v2).
  fingerprintVersion     String?  @default("normalized-document-v2")
  languageSource         String?
  languageConfidence     Float?
  structureSummaryJson   Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  bundle  DoclingImportBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)
  pack    KnowledgePack        @relation(fields: [packId], references: [packId], onDelete: Restrict)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@index([bundleId, isActive])
  @@index([packId, versionId])
  /// Partial unique: one active ND per bundle — enforced in migration SQL:
  /// CREATE UNIQUE INDEX "NormalizedDocument_one_active_per_bundle" ON "NormalizedDocument" ("bundleId") WHERE "isActive" = true;
}

model DoclingProcessingLog {
  id             String                  @id @default(cuid())
  bundleId       String
  stage          DoclingProcessingStage
  status         DoclingProcessingStatus
  attempt        Int                     @default(1)
  adapterVersion String?
  message        String?
  errorCode      String?
  detailsJson    Json?
  startedAt      DateTime                @default(now())
  completedAt    DateTime?
  createdAt      DateTime                @default(now())

  bundle DoclingImportBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@index([bundleId, stage, createdAt])
}

model SourceDocument {
  id                   String                 @id @default(cuid())
  versionId            String
  title                String
  sourceType           SourceType             @default(ETC)
  legacySourceType     String?
  sourceFormat         SourceFormat           @default(TEXT)
  sourceUrl            String?
  fileName             String?
  mimeType             String?
  content              String?
  checksum             String?
  productVersion       String?
  documentVersion      String?
  licenseStatus        String?
  validationStatus     SourceValidationStatus @default(NOT_CHECKED)
  validationSummary    String?
  registeredByClientId String?
  registeredAt         DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]
  validationReports SourceValidationReport[]

  @@index([versionId])
  @@index([sourceType])
  @@index([validationStatus])
}

model KnowledgeChunk {
  id               String   @id @default(cuid())
  versionId        String
  sourceDocumentId String?
  chunkType        String
  title            String
  content          String
  section          String?
  tags             String[]
  metadata         Json?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version        KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  embeddings     KnowledgeChunkEmbedding[]

  @@index([versionId])
  @@index([chunkType])
  @@index([isActive])
}

model KnowledgeChunkEmbedding {
  id          String   @id @default(cuid())
  chunkId     String
  versionId   String
  provider    String
  model       String
  dimension   Int
  vector      Json
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunk   KnowledgeChunk       @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([chunkId, provider, model])
  @@index([versionId])
  @@index([provider, model])
  @@index([contentHash])
}

model KnowledgeGraphNode {
  id         String   @id @default(cuid())
  packId     String
  versionId  String?
  nodeType   String
  externalId String
  label      String
  summary    String?
  metadata   Json?
  source     String   @default("AUTO_DETERMINISTIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pack    KnowledgePack         @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version KnowledgePackVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  outgoing KnowledgeGraphEdge[] @relation("GraphEdgeFrom")
  incoming KnowledgeGraphEdge[] @relation("GraphEdgeTo")

  @@unique([packId, externalId])
  @@index([packId])
  @@index([versionId])
  @@index([nodeType])
  @@index([source])
}

model KnowledgeGraphEdge {
  id         String   @id @default(cuid())
  packId     String
  versionId  String?
  edgeType   String
  fromNodeId String
  toNodeId   String
  weight     Float    @default(1)
  metadata   Json?
  source     String   @default("AUTO_DETERMINISTIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pack    KnowledgePack         @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version KnowledgePackVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  from    KnowledgeGraphNode    @relation("GraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to      KnowledgeGraphNode    @relation("GraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([packId, edgeType, fromNodeId, toNodeId])
  @@index([packId])
  @@index([versionId])
  @@index([edgeType])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([source])
}

model PackInstallation {
  id             String             @id @default(cuid())
  clientId       String?
  userId         String?
  organizationId String?
  packId         String
  status         InstallationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  pack         KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@unique([clientId, packId])
  @@unique([userId, packId])
  @@unique([organizationId, packId])
  @@index([clientId])
  @@index([userId])
  @@index([organizationId])
  @@index([packId])
}

model ApiKey {
  id             String       @id @default(cuid())
  clientId       String?
  userId         String?
  organizationId String?
  name           String
  keyPrefix      String
  keyHash        String
  scopes         String[]
  status         ApiKeyStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  expiresAt      DateTime?

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  usageLogs ApiUsageLog[]

  @@index([clientId])
  @@index([keyPrefix])
  @@index([status])
  @@index([expiresAt])
}

model ApiUsageLog {
  id         String   @id @default(cuid())
  requestId  String   @unique
  apiKeyId   String?
  clientId   String?
  packId     String?
  endpoint   String
  method     String?
  target     String?
  query      String?
  usedChunks Int      @default(0)
  statusCode Int
  latencyMs  Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  apiKey ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  pack   KnowledgePack? @relation(fields: [packId], references: [packId], onDelete: SetNull)

  @@index([apiKeyId])
  @@index([clientId])
  @@index([packId])
  @@index([statusCode])
  @@index([createdAt])
  @@index([clientId, createdAt])
  @@index([statusCode, createdAt])
}

model SourceValidationReport {
  id                 String                 @id @default(cuid())
  sourceDocumentId   String
  packId             String
  versionId          String
  sourceType         SourceType
  sourceFormat       SourceFormat
  status             SourceValidationStatus
  score              Int                    @default(0)
  summary            String
  issueCount         Int                    @default(0)
  blockingIssueCount Int                    @default(0)
  warningIssueCount  Int                    @default(0)
  checkedBy          String                 @default("SYSTEM_RULE")
  checkedAt          DateTime               @default(now())
  createdAt          DateTime               @default(now())

  sourceDocument SourceDocument       @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)
  pack           KnowledgePack        @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version        KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  issues         SourceValidationIssue[]

  @@index([sourceDocumentId])
  @@index([packId])
  @@index([versionId])
  @@index([status])
  @@index([checkedAt])
}

model SourceValidationIssue {
  id        String   @id @default(cuid())
  reportId  String
  severity  String
  code      String
  message   String
  field     String?
  hint      String?
  createdAt DateTime @default(now())

  report SourceValidationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([severity])
  @@index([code])
}

model KnowledgeStructureTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique
  name        String
  description String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections KnowledgeStructureSection[]

  @@index([templateKey])
  @@index([isActive])
}

model KnowledgeStructureSection {
  id          String   @id @default(cuid())
  templateId  String
  sectionKey  String
  title       String
  description String
  required    Boolean  @default(true)
  weight      Int      @default(10)
  sourceTypes String[]
  keywords    String[]
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  template KnowledgeStructureTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, sectionKey])
  @@index([templateId])
  @@index([required])
}

model StructureCoverageReport {
  id                   String   @id @default(cuid())
  packId               String
  versionId            String
  templateKey          String
  status               String
  coverageScore        Int      @default(0)
  requiredSectionCount Int      @default(0)
  coveredRequiredCount Int      @default(0)
  missingRequiredCount Int      @default(0)
  optionalSectionCount Int      @default(0)
  coveredOptionalCount Int      @default(0)
  summary              String
  checkedBy            String   @default("SYSTEM_RULE")
  checkedAt            DateTime @default(now())
  createdAt            DateTime @default(now())

  pack    KnowledgePack        @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  items   StructureCoverageItem[]

  @@index([packId])
  @@index([versionId])
  @@index([templateKey])
  @@index([status])
  @@index([checkedAt])
}

model StructureCoverageItem {
  id             String   @id @default(cuid())
  reportId       String
  sectionKey     String
  title          String
  required       Boolean
  covered        Boolean
  score          Int      @default(0)
  matchedDocIds  String[]
  matchedSignals String[]
  message        String
  createdAt      DateTime @default(now())

  report StructureCoverageReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([sectionKey])
  @@index([covered])
  @@index([required])
}

