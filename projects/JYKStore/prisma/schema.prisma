model ChunkQualityReport {
  id                         String   @id @default(cuid())
  packId                     String
  versionId                  String
  status                     String
  totalScore                 Int      @default(0)

  coverageScore              Int      @default(0)
  traceabilityScore          Int      @default(0)
  sizeScore                  Int      @default(0)
  duplicateScore             Int      @default(0)
  metadataScore              Int      @default(0)
  structureAlignmentScore    Int      @default(0)

  activeChunkCount           Int      @default(0)
  inactiveChunkCount         Int      @default(0)
  sourceDocumentCount        Int      @default(0)
  coveredSourceDocumentCount Int      @default(0)
  orphanChunkCount           Int      @default(0)
  missingSourceChunkCount    Int      @default(0)
  shortChunkCount            Int      @default(0)
  longChunkCount             Int      @default(0)
  duplicateChunkCount        Int      @default(0)
  chunkWithoutMetadataCount  Int      @default(0)

  blockingIssueCount         Int      @default(0)
  warningIssueCount          Int      @default(0)
  summary                    String
  checkedBy                  String   @default("SYSTEM_RULE")
  checkedAt                  DateTime @default(now())
  createdAt                  DateTime @default(now())

