model PipelineRun {
  id                  String             @id @default(cuid())
  packId              String
  status              PipelineStepStatus @default(RUNNING)
  triggerType         String
  triggeredByClientId String?
  summary             String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pack  KnowledgePack     @relation(fields: [packId], references: [packId], onDelete: Cascade)
  steps PipelineStepLog[]

  @@index([packId])
  @@index([status])
  @@index([triggerType])
  @@index([startedAt])
}

model PipelineStepLog {
  id         String             @id @default(cuid())
  runId      String
  packId     String
  step       PipelineStatus
  status     PipelineStepStatus @default(PENDING)
  message    String?
  details    Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  run  PipelineRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  pack KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@index([runId])
  @@index([packId])
  @@index([step])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime    @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
