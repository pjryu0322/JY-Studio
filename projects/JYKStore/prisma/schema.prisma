generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackStatus {
  DRAFT
  REVIEWING
  VERIFIED
  PUBLISHED
  DEPRECATED
  SUSPENDED
}

enum PackPricing {
  FREE
  PAID
  ENTERPRISE
}

enum ProviderType {
  JYK_VERIFIED
  OFFICIAL
  COMMUNITY
}

enum InstallationStatus {
  ACTIVE
  REMOVED
}

enum ApiKeyStatus {
  ACTIVE
  REVOKED
}

enum SourceType {
  PRODUCT_MANUAL
  INTEGRATION_GUIDE
  API_SPEC
  OPENAPI_SCHEMA
  ERROR_CODE_TABLE
  SAMPLE_CODE
  FAQ
  RELEASE_NOTE
  SECURITY_GUIDE
  TEST_ENV_GUIDE
  OPERATION_GUIDE
  CALLBACK_GUIDE
  TROUBLESHOOTING
  ETC
}

enum SourceFormat {
  TEXT
  MARKDOWN
  HTML
  PDF
  DOCX
  XLSX
  CSV
  JSON
  YAML
  OPENAPI_JSON
  OPENAPI_YAML
  CODE
  URL
  ETC
}

enum SourceValidationStatus {
  NOT_CHECKED
  PASS
  WARNING
  FAIL
}

enum PipelineStatus {
  SOURCE_REGISTERING
  SOURCE_VALIDATING
  STRUCTURING
  STRUCTURE_VALIDATING
  KNOWLEDGE_CHECKING
  CHUNKING
  CHUNK_EVALUATING
  INDEXING
  SEARCH_EVALUATING
  READY_FOR_REVIEW
  REVIEWING
  APPROVED
  PUBLISHED
  FAILED
}

enum PipelineStepStatus {
  PENDING
  RUNNING
  PASS
  WARNING
  FAIL
  SKIPPED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  PUBLISH
  DEPRECATE
  SUSPEND
  INSTALL
  REMOVE
  API_KEY_CREATE
  API_KEY_REVOKE
  PROVIDER_PROFILE_UPSERT
  PROVIDER_PACK_CREATE
  PROVIDER_PACK_UPDATE
  PROVIDER_PACK_VERSION_CREATE
  PROVIDER_SOURCE_DOCUMENT_CREATE
  PROVIDER_PACK_SUBMIT
  ADMIN_REVIEW_CREATE
  ADMIN_REVIEW_UPDATE
  ADMIN_PACK_APPROVE
  ADMIN_PACK_REJECT
  ADMIN_CHUNK_CREATE
  ADMIN_CHUNK_UPDATE
  ADMIN_CHUNK_DEACTIVATE
  ADMIN_CHUNK_GENERATE
}

model ProviderProfile {
  id             String   @id @default(cuid())
  clientId       String?  @unique
  userId         String?
  organizationId String?
  displayName    String
  description    String
  websiteUrl     String?
  contactEmail   String?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  packs        KnowledgePack[]

  @@index([userId])
  @@index([organizationId])
  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   OrganizationMember[]
  installations PackInstallation[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  providerProfiles ProviderProfile[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members       OrganizationMember[]
  installations PackInstallation[]
  apiKeys       ApiKey[]
  providerProfiles ProviderProfile[]
}

model OrganizationMember {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model PackCategory {
  id          String   @id @default(cuid())
  categoryId  String   @unique
  name        String
  description String
  icon        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packs KnowledgePack[]
}

model KnowledgePack {
  id                String       @id @default(cuid())
  packId            String       @unique
  name              String
  categoryId        String
  providerName      String
  providerType      ProviderType
  providerProfileId String?
  status            PackStatus
  pricing          PackPricing
  icon             String
  shortDescription String
  description      String
  tags             String[]
  rating           Float        @default(0)
  usageCount       Int          @default(0)
  isVerified       Boolean      @default(false)
  pipelineStatus    PipelineStatus @default(SOURCE_REGISTERING)
  pipelineUpdatedAt DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  publishedAt      DateTime?

  category        PackCategory           @relation(fields: [categoryId], references: [categoryId])
  providerProfile ProviderProfile?       @relation(fields: [providerProfileId], references: [id], onDelete: SetNull)
  versions        KnowledgePackVersion[]
  installations PackInstallation[]
  usageLogs     ApiUsageLog[]
  reviews       PackReview[]
  graphNodes    KnowledgeGraphNode[]
  graphEdges    KnowledgeGraphEdge[]
  pipelineRuns     PipelineRun[]
  pipelineStepLogs PipelineStepLog[]

  @@index([status])
  @@index([categoryId])
  @@index([providerProfileId])
  @@index([pipelineStatus])
}

model PackReview {
  id               String    @id @default(cuid())
  packId           String
  reviewerClientId String?
  status           String
  decision         String?
  memo             String?
  rejectionReason  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  decidedAt        DateTime?

  pack KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@index([packId])
  @@index([status])
  @@index([decision])
  @@index([createdAt])
}

model KnowledgePackVersion {
  id                    String   @id @default(cuid())
  packId                String
  version               String
  overview              String
  features              String[]
  includedKnowledge     String[]
  supportedEnvironments String[]
  targetUsers           String[]
  useCases              String[]
  versionSummary        String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  pack            KnowledgePack    @relation(fields: [packId], references: [packId], onDelete: Cascade)
  sourceDocuments SourceDocument[]
  chunks          KnowledgeChunk[]
  embeddings      KnowledgeChunkEmbedding[]
  graphNodes      KnowledgeGraphNode[]
  graphEdges      KnowledgeGraphEdge[]

  @@unique([packId, version])
  @@index([packId])
}

model SourceDocument {
  id                   String                 @id @default(cuid())
  versionId            String
  title                String
  sourceType           SourceType             @default(ETC)
  legacySourceType     String?
  sourceFormat         SourceFormat           @default(TEXT)
  sourceUrl            String?
  fileName             String?
  mimeType             String?
  content              String?
  checksum             String?
  productVersion       String?
  documentVersion      String?
  licenseStatus        String?
  validationStatus     SourceValidationStatus @default(NOT_CHECKED)
  validationSummary    String?
  registeredByClientId String?
  registeredAt         DateTime               @default(now())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  chunks  KnowledgeChunk[]

  @@index([versionId])
  @@index([sourceType])
  @@index([validationStatus])
}

model KnowledgeChunk {
  id               String   @id @default(cuid())
  versionId        String
  sourceDocumentId String?
  chunkType        String
  title            String
  content          String
  section          String?
  tags             String[]
  metadata         Json?
  sortOrder        Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version        KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  sourceDocument SourceDocument?      @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  embeddings     KnowledgeChunkEmbedding[]

  @@index([versionId])
  @@index([chunkType])
  @@index([isActive])
}

model KnowledgeChunkEmbedding {
  id          String   @id @default(cuid())
  chunkId     String
  versionId   String
  provider    String
  model       String
  dimension   Int
  vector      Json
  contentHash String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunk   KnowledgeChunk       @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  version KnowledgePackVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([chunkId, provider, model])
  @@index([versionId])
  @@index([provider, model])
  @@index([contentHash])
}

model KnowledgeGraphNode {
  id         String   @id @default(cuid())
  packId     String
  versionId  String?
  nodeType   String
  externalId String
  label      String
  summary    String?
  metadata   Json?
  source     String   @default("AUTO_DETERMINISTIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pack    KnowledgePack         @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version KnowledgePackVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)

  outgoing KnowledgeGraphEdge[] @relation("GraphEdgeFrom")
  incoming KnowledgeGraphEdge[] @relation("GraphEdgeTo")

  @@unique([packId, externalId])
  @@index([packId])
  @@index([versionId])
  @@index([nodeType])
  @@index([source])
}

model KnowledgeGraphEdge {
  id         String   @id @default(cuid())
  packId     String
  versionId  String?
  edgeType   String
  fromNodeId String
  toNodeId   String
  weight     Float    @default(1)
  metadata   Json?
  source     String   @default("AUTO_DETERMINISTIC")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  pack    KnowledgePack         @relation(fields: [packId], references: [packId], onDelete: Cascade)
  version KnowledgePackVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  from    KnowledgeGraphNode    @relation("GraphEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  to      KnowledgeGraphNode    @relation("GraphEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([packId, edgeType, fromNodeId, toNodeId])
  @@index([packId])
  @@index([versionId])
  @@index([edgeType])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@index([source])
}

model PackInstallation {
  id             String             @id @default(cuid())
  clientId       String?
  userId         String?
  organizationId String?
  packId         String
  status         InstallationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  pack         KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@unique([clientId, packId])
  @@unique([userId, packId])
  @@unique([organizationId, packId])
  @@index([clientId])
  @@index([userId])
  @@index([organizationId])
  @@index([packId])
}

model ApiKey {
  id             String       @id @default(cuid())
  clientId       String?
  userId         String?
  organizationId String?
  name           String
  keyPrefix      String
  keyHash        String
  scopes         String[]
  status         ApiKeyStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  lastUsedAt     DateTime?
  revokedAt      DateTime?

  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  usageLogs ApiUsageLog[]

  @@index([clientId])
  @@index([keyPrefix])
  @@index([status])
}

model ApiUsageLog {
  id         String   @id @default(cuid())
  requestId  String   @unique
  apiKeyId   String?
  packId     String?
  endpoint   String
  method     String?
  target     String?
  query      String?
  usedChunks Int      @default(0)
  statusCode Int
  latencyMs  Int?
  metadata   Json?
  createdAt  DateTime @default(now())

  apiKey ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  pack   KnowledgePack? @relation(fields: [packId], references: [packId], onDelete: SetNull)

  @@index([apiKeyId])
  @@index([packId])
  @@index([statusCode])
  @@index([createdAt])
}

model PipelineRun {
  id                  String             @id @default(cuid())
  packId              String
  status              PipelineStepStatus @default(RUNNING)
  triggerType         String
  triggeredByClientId String?
  summary             String?
  startedAt           DateTime           @default(now())
  finishedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  pack  KnowledgePack     @relation(fields: [packId], references: [packId], onDelete: Cascade)
  steps PipelineStepLog[]

  @@index([packId])
  @@index([status])
  @@index([triggerType])
  @@index([startedAt])
}

model PipelineStepLog {
  id         String             @id @default(cuid())
  runId      String
  packId     String
  step       PipelineStatus
  status     PipelineStepStatus @default(PENDING)
  message    String?
  details    Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  run  PipelineRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  pack KnowledgePack @relation(fields: [packId], references: [packId], onDelete: Cascade)

  @@index([runId])
  @@index([packId])
  @@index([step])
  @@index([status])
}

model AuditLog {
  id          String      @id @default(cuid())
  actorUserId String?
  action      AuditAction
  entityType  String
  entityId    String
  metadata    Json?
  createdAt   DateTime    @default(now())

  actorUser User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
