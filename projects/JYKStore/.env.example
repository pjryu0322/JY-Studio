JYKSTORE_PORT=3004
JYKSTORE_APP_NAME=JYKStore
JYKSTORE_API_BASE_URL=http://localhost:3004

# Prisma datasource uses DATABASE_URL (production required; checked by /api/ready).
DATABASE_URL="postgresql://jykstore:jykstore@localhost:5432/JYKStore?schema=public"

JYKSTORE_API_KEY_SECRET="replace-with-random-secret"
# Production required: strong random secret for API Key hashing (do not use empty or dev-only fallback).

# Comma-separated emails that receive ADMIN accountRole on login (admin console access).
# Example: admin@example.com,ops@example.com
JYKSTORE_ADMIN_EMAILS=

# Public API quota policy (tenantKey = ApiKey.clientId, fallback apiKeyId)
JYKSTORE_QUOTA_PER_MINUTE=30
JYKSTORE_QUOTA_PER_DAY=1000
# ENFORCE returns 429 QUOTA_EXCEEDED; WARN_ONLY logs warning without blocking
JYKSTORE_QUOTA_ENFORCEMENT=ENFORCE

# P22 MCP Server Bridge (do not commit real API keys)
# See docs/mcp-runtime-ops-guide.md for deployment checklist and troubleshooting.
JYKSTORE_BASE_URL=http://localhost:3004
JYKSTORE_API_KEY=<YOUR_JYKSTORE_API_KEY_WITH_CONTEXT_READ_SCOPE>
JYKSTORE_MCP_TRANSPORT=stdio
JYKSTORE_MCP_PORT=3014
JYKSTORE_MCP_ALLOWED_PACK_IDS=
# HTTP CORS allowlist (comma-separated). Empty ≈ localhost Origins only. "*" is development-only.
JYKSTORE_MCP_ALLOWED_ORIGINS=
# Response / export source size guards (bytes)
JYKSTORE_MCP_MAX_RESPONSE_BYTES=2000000
JYKSTORE_MCP_MAX_EXPORT_SOURCE_BYTES=20000000

# Immutable payload distribution — S3-compatible Object Storage only (no local FS fallback)
JYKSTORE_PAYLOAD_STORAGE_DRIVER=s3
JYKSTORE_PAYLOAD_S3_ENDPOINT=
JYKSTORE_PAYLOAD_S3_REGION=ap-northeast-2
JYKSTORE_PAYLOAD_S3_BUCKET=
JYKSTORE_PAYLOAD_S3_ACCESS_KEY_ID=
JYKSTORE_PAYLOAD_S3_SECRET_ACCESS_KEY=
JYKSTORE_PAYLOAD_S3_FORCE_PATH_STYLE=false
JYKSTORE_PAYLOAD_S3_PREFIX=payloads
JYKSTORE_PAYLOAD_S3_SERVER_SIDE_ENCRYPTION=AES256
# ZIP / unpack limits (bytes unless noted)
JYKSTORE_PAYLOAD_MAX_BYTES=52428800
JYKSTORE_PAYLOAD_MAX_ENTRIES=5000
JYKSTORE_PAYLOAD_MAX_UNPACKED_BYTES=209715200
# JYKSTORE_PAYLOAD_MAX_SINGLE_ENTRY_BYTES=
# JYKSTORE_PAYLOAD_MAX_PATH_LENGTH=
# JYKSTORE_PAYLOAD_MAX_COMPRESSION_RATIO=
# Public payload download anonymous quota
JYKSTORE_PAYLOAD_DOWNLOAD_PER_MINUTE=10
JYKSTORE_PAYLOAD_DOWNLOAD_PER_DAY=100
# Trust forwarding headers only behind a trusted reverse proxy. Production public
# payload downloads require this to be true.
JYKSTORE_TRUST_PROXY=false
# Random HMAC secret for anonymous download identities. Required for all environments;
# never reuse JYKSTORE_API_KEY_SECRET or commit a real value.
JYKSTORE_ANONYMOUS_ID_SECRET=

# Optional: GitHub auto-collect (P26.1+). Public repos work without a token; token raises API rate limits.
# GITHUB_TOKEN=

# Development-only test account selector.
# Ignored in production and allowed only from localhost.
JYKSTORE_ENABLE_TEST_ACCOUNT_SWITCHER=false
