JYKSTORE_PORT=3004
JYKSTORE_APP_NAME=JYKStore
JYKSTORE_API_BASE_URL=http://localhost:3004

# Prisma datasource uses DATABASE_URL (production required; checked by /api/ready).
DATABASE_URL="postgresql://jykstore:jykstore@localhost:5432/JYKStore?schema=public"

JYKSTORE_API_KEY_SECRET="replace-with-random-secret"
# Production required: strong random secret for API Key hashing (do not use empty or dev-only fallback).

# Admin ops token for internal admin APIs (API Key list/revoke, quota summary, admin packs/ops/reviews).
# Production required. Send as header: X-JYKStore-Admin-Token: <token>
# Do not commit a real token.
JYKSTORE_ADMIN_OPS_TOKEN=

# Public API quota policy (tenantKey = ApiKey.clientId, fallback apiKeyId)
JYKSTORE_QUOTA_PER_MINUTE=30
JYKSTORE_QUOTA_PER_DAY=1000
# ENFORCE returns 429 QUOTA_EXCEEDED; WARN_ONLY logs warning without blocking
JYKSTORE_QUOTA_ENFORCEMENT=ENFORCE

# P22 MCP Server Bridge (do not commit real API keys)
# See docs/mcp-runtime-ops-guide.md for deployment checklist and troubleshooting.
JYKSTORE_BASE_URL=http://localhost:3004
JYKSTORE_API_KEY=<YOUR_JYKSTORE_API_KEY_WITH_CONTEXT_READ_SCOPE>
JYKSTORE_MCP_TRANSPORT=stdio
JYKSTORE_MCP_PORT=3014
JYKSTORE_MCP_ALLOWED_PACK_IDS=
# HTTP CORS allowlist (comma-separated). Empty ≈ localhost Origins only. "*" is development-only.
JYKSTORE_MCP_ALLOWED_ORIGINS=
# Response / export source size guards (bytes)
JYKSTORE_MCP_MAX_RESPONSE_BYTES=2000000
JYKSTORE_MCP_MAX_EXPORT_SOURCE_BYTES=20000000

# Optional: GitHub auto-collect (P26.1+). Public repos work without a token; token raises API rate limits.
# GITHUB_TOKEN=
