JYKSTORE_PORT=3004
JYKSTORE_APP_NAME=JYKStore
JYKSTORE_API_BASE_URL=http://localhost:3004

# Prisma datasource uses DATABASE_URL (production required; checked by /api/ready).
DATABASE_URL="postgresql://jykstore:jykstore@localhost:5432/JYKStore?schema=public"

JYKSTORE_API_KEY_SECRET="replace-with-random-secret"
# Production required: strong random secret for API Key hashing (do not use empty or dev-only fallback).

# Comma-separated emails that receive ADMIN accountRole on login (admin console access).
# P11 canonical admin: admin@jyk.local (also seeded with accountRole=ADMIN).
# Example: admin@jyk.local,admin@example.com
JYKSTORE_ADMIN_EMAILS=admin@jyk.local

# Public API quota policy (tenantKey = ApiKey.clientId, fallback apiKeyId)
JYKSTORE_QUOTA_PER_MINUTE=30
JYKSTORE_QUOTA_PER_DAY=1000
# ENFORCE returns 429 QUOTA_EXCEEDED; WARN_ONLY logs warning without blocking
JYKSTORE_QUOTA_ENFORCEMENT=ENFORCE

# P22 MCP Server Bridge (do not commit real API keys)
# See docs/mcp-runtime-ops-guide.md for deployment checklist and troubleshooting.
JYKSTORE_BASE_URL=http://localhost:3004
JYKSTORE_API_KEY=<YOUR_JYKSTORE_API_KEY_WITH_CONTEXT_READ_SCOPE>
JYKSTORE_MCP_TRANSPORT=stdio
JYKSTORE_MCP_PORT=3014
JYKSTORE_MCP_ALLOWED_PACK_IDS=
# HTTP CORS allowlist (comma-separated). Empty ≈ localhost Origins only. "*" is development-only.
JYKSTORE_MCP_ALLOWED_ORIGINS=
# Response / export source size guards (bytes)
JYKSTORE_MCP_MAX_RESPONSE_BYTES=2000000
JYKSTORE_MCP_MAX_EXPORT_SOURCE_BYTES=20000000

# Immutable payload distribution — S3-compatible Object Storage only (no local FS fallback)
JYKSTORE_PAYLOAD_STORAGE_DRIVER=s3
JYKSTORE_PAYLOAD_S3_ENDPOINT=
JYKSTORE_PAYLOAD_S3_REGION=ap-northeast-2
JYKSTORE_PAYLOAD_S3_BUCKET=
JYKSTORE_PAYLOAD_S3_ACCESS_KEY_ID=
JYKSTORE_PAYLOAD_S3_SECRET_ACCESS_KEY=
JYKSTORE_PAYLOAD_S3_FORCE_PATH_STYLE=false
JYKSTORE_PAYLOAD_S3_PREFIX=payloads
JYKSTORE_PAYLOAD_S3_SERVER_SIDE_ENCRYPTION=AES256
# Docling multipart upload policy (defaults shown)
# JYKSTORE_DOCLING_MAX_SOURCE_BYTES=1073741824
# JYKSTORE_DOCLING_MAX_JSON_BYTES=1073741824
# JYKSTORE_DOCLING_MAX_MARKDOWN_BYTES=536870912
# JYKSTORE_DOCLING_MAX_BUNDLE_BYTES=2147483648
# JYKSTORE_DOCLING_MULTIPART_PART_BYTES=16777216
# JYKSTORE_DOCLING_MULTIPART_CONCURRENCY=3
# JYKSTORE_DOCLING_UPLOAD_SESSION_TTL_SECONDS=86400
# JYKSTORE_DOCLING_PRESIGNED_URL_TTL_SECONDS=900
# Browser origin used by the Provider UI (MinIO CORS AllowedOrigin should match).
# JYKSTORE_PUBLIC_APP_ORIGIN=http://localhost:3004
# MinIO / S3 CORS for browser multipart PUT:
#   AllowedOrigin: value of JYKSTORE_PUBLIC_APP_ORIGIN (and production app origin)
#   AllowedMethods: PUT, GET, HEAD
#   AllowedHeaders: *
#   ExposeHeaders: ETag
#   MaxAgeSeconds: 3000
# ZIP payload upload is removed — cleanup then migrate:
#   npm run cleanup:legacy-zip-payloads -- --apply
# Public payload download anonymous quota
JYKSTORE_PAYLOAD_DOWNLOAD_PER_MINUTE=10
JYKSTORE_PAYLOAD_DOWNLOAD_PER_DAY=100
# Trust forwarding headers only behind a trusted reverse proxy. Production public
# payload downloads require this to be true.
JYKSTORE_TRUST_PROXY=false
# Random HMAC secret for anonymous download identities. Required for all environments;
# never reuse JYKSTORE_API_KEY_SECRET or commit a real value.
JYKSTORE_ANONYMOUS_ID_SECRET=

# P5 local E5 embedding (operational search generations require local-e5 + worker)
# JYKSTORE_EMBEDDING_PROVIDER=local-e5
# JYKSTORE_EMBEDDING_MODEL=dragonkue/multilingual-e5-small-ko-v2
# JYKSTORE_EMBEDDING_DIMENSION=384
# JYKSTORE_EMBEDDING_WORKER_URL=http://embedding-worker:8000
# JYKSTORE_EMBEDDING_BATCH_SIZE=16
# Pinned Hugging Face FULL commit SHA (40-char lowercase hex) — REQUIRED for new Generations
# and for Runtime Readiness. Branch/tag names and "legacy-unknown" are rejected.
# JYKSTORE_EMBEDDING_MODEL_REVISION=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Internal bearer token shared with the worker (E5_WORKER_TOKEN) — REQUIRED in production
# and for Runtime Readiness when provider=local-e5.
# JYKSTORE_EMBEDDING_WORKER_TOKEN=
# Dev stub worker: npm run dev:embedding-worker  (serves stub on http://127.0.0.1:8010)
#
# Embedding Worker (embedding-worker/, internal network only — never expose publicly):
# Local E5 live worker — all required (install + live). Do not commit real values or tokens.
# E5_MODEL_ID=dragonkue/multilingual-e5-small-ko-v2
# E5_MODEL_REVISION=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# E5_MODEL_DIR=C:\JYKStore\models\multilingual-e5-small-ko-v2\aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# E5_MODEL_OFFLINE=true
# E5_WORKER_TOKEN=<local-internal-token>
#   E5_WORKER_ENV=development|test|production
#   E5_WORKER_STUB=false            # MUST be false in production (startup fails otherwise)
#   E5_MODEL_REVISION and E5_MODEL_DIR are required for install and the live worker
#   (40-char lowercase HF commit SHA; no latest/branch/tag auto-resolve; no default model dir).
#   E5_WORKER_TOKEN must match JYKSTORE_EMBEDDING_WORKER_TOKEN
#   E5_MAX_BATCH_SIZE=32 E5_MAX_TEXT_BYTES=20000 E5_MAX_REQUEST_BYTES=300000 E5_MAX_CONCURRENCY=1
#
# Python Worker (python-worker/) local E5 embeddings — the Next.js server spawns the
# Worker with its own env, so these must be set for the ZIP knowledge build to produce
# embeddings. The Worker NEVER downloads: it loads a pre-installed local model offline.
#   1) Install the pinned model once (network allowed only here):
#      set E5_MODEL_REVISION + E5_MODEL_DIR above, then: npm run embedding-model:install
#   2) Point the Worker at that installed directory:
# JYKSTORE_PYTHON_WORKER_EMBEDDING_MODE=local_e5          # local_e5 (default) | deterministic_stub (tests only)
# JYKSTORE_PYTHON_WORKER_E5_MODEL_PATH=C:\JYKStore\models\multilingual-e5-small-ko-v2\aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# JYKSTORE_PYTHON_WORKER_E5_MODEL_NAME=dragonkue/multilingual-e5-small-ko-v2
# Offline/production: pre-download the model and set JYKSTORE_PYTHON_WORKER_E5_MODEL_PATH to its path.
#
# P5.2 / P8.1.3: when true, missing pgvector hard-fails (no JSON vector fallback).
# JYKSTORE_REQUIRE_PGVECTOR=true
# Explicit degraded mode only: generation-scoped JSON neighbors when pgvector is down.
# Ignored when JYKSTORE_REQUIRE_PGVECTOR or NODE_ENV=production.
# JYKSTORE_ALLOW_JSON_VECTOR_FALLBACK=true

# Deprecated Provider UI: Docling JSON/Markdown manual upload card (default hidden).
# Backend Docling routes remain until P11 schema cutover. Set to 1 only for debug.
# NEXT_PUBLIC_PROVIDER_LEGACY_DOCLING=0

# Optional: GitHub auto-collect (P26.1+). Public repos work without a token; token raises API rate limits.
# Routes are frozen (410 LEGACY_BUILDER_DISABLED). Token unused unless resurrected.
# GITHUB_TOKEN=

# Development-only test account selector.
# Ignored in production. Allowed from loopback and private LAN (e.g. 192.168.x.x).
# After P11 clean reset, Quick Login should list only the 3 canonical accounts.
JYKSTORE_ENABLE_TEST_ACCOUNT_SWITCHER=false
