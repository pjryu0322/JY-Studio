# Python Worker (python-worker/) — local E5 embedding configuration.
#
# Copy to `.env` (git-ignored) for standalone CLI runs, or set these on the
# Next.js server process (which spawns the Worker and passes its env through).
#
# The Worker NEVER downloads a model at runtime — it loads a PRE-INSTALLED local
# model offline (local_files_only=True). Model files are NOT committed to git;
# only this template and the install script are.
#
# ── Mode ─────────────────────────────────────────────────────────────────────
#   local_e5           production / default (requires a local model directory)
#   deterministic_stub tests only (hash-based vectors, dim 8, no model)
JYKSTORE_PYTHON_WORKER_EMBEDDING_MODE=local_e5

# ── Local model path (required for local_e5) ─────────────────────────────────
# Point this at a pre-installed sentence-transformers model directory. Install
# the pinned model once via the shared installer (network allowed only there):
#
#   # from the repo root, with the pinned 40-char HF commit SHA:
#   set E5_MODEL_REVISION=<pinned-40-char-sha>
#   set E5_MODEL_DIR=C:\JYKStore\models\multilingual-e5-small-ko-v2\<pinned-sha>
#   npm run embedding-model:install
#
# then set the Worker to the same directory:
JYKSTORE_PYTHON_WORKER_E5_MODEL_PATH=C:\JYKStore\models\multilingual-e5-small-ko-v2\<pinned-sha>

# ── Model name (descriptor metadata only; does not trigger a download) ────────
JYKSTORE_PYTHON_WORKER_E5_MODEL_NAME=dragonkue/multilingual-e5-small-ko-v2

# Offline / air-gapped: copy the pre-downloaded model directory to the target
# host and set JYKSTORE_PYTHON_WORKER_E5_MODEL_PATH to its absolute path. No
# network access is required at Worker runtime.
